<style>
	.image-box {
		width: 200px; /* jitna chaho width fix kar lo */
		height: 250px; /* jitna chaho height fix kar lo */
		margin: 0 auto; /* center me karne ke liye */
		border: 1px solid #ddd;
		border-radius: 6px;
		overflow: hidden; /* image bahar na nikle */
	}

		.image-box img {
			width: 100%;
			height: 100%;
			object-fit: cover; /* image crop ho kar fit hogi */
		}

	.image-box-modal {
		width: 400px; /* jitna chaho width fix kar lo */
		height: 400px; /* jitna chaho height fix kar lo */
		margin: 0 auto; /* center me karne ke liye */
		border: 1px solid #ddd;
		border-radius: 6px;
		overflow: hidden; /* image bahar na nikle */
	}

		.image-box-modal img {
			width: 100%;
			height: 100%;
			object-fit: cover; /* image crop ho kar fit hogi */
		}

	#cameraPreview {
		transform: scaleX(-1); /* mirror effect for live preview */
	}


</style>

