        <style>
            @@import url('https://fonts.googleapis.com/css?family=Roboto:100,300,400,500,700,900&display=swap');

            .dx-datagrid .dx-data-row > td.bullet {
                padding-top: 0;
                padding-bottom: 0;
            }

            #Loader {
                top: 0;
                left: 0;
                z-index: 1002;
                display: none;
                position: fixed;
                width: 100%;
                height: 100%;
                background-color: rgb(255 255 255 / 57%);
            }

            #form .dx-fieldset {
                height: 500px;
            }

            .hide {
                display: none !important;
            }

            .span {
                color: red;
                font-size: 9px;
            }

            input::-webkit-outer-spin-button,
            input::-webkit-inner-spin-button {
                display: none;
            }

            /* .dx-toolbar-label .dx-toolbar-item-content > div {
                                                                overflow: hidden;
                                                                text-overflow: ellipsis;
                                                                white-space: nowrap;
                                                                display: none;
                                                            } */

            .form-control,
            .form-select {
                font-size: 11px;
                padding: 2px 10px;
                box-shadow: inherit !important;
            }

            label.form-label {
                font-size: 10px;
                margin-bottom: 3px;
                font-weight: 600;
            }

            textarea.form-control {
                min-height: calc(0.5em + 0.75rem + 2px);
            }

            .nav-link {
                display: block;
                padding: 0.2rem 1rem;
                color: #0d6efd;
                text-decoration: none;
                transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out;
            }

            .table {
                overflow-y: auto;
            }

            .dx-group-panel-message {
                z-index: 9999999;
            }

            .nav-tabs li.nav-item .nav-link {
                font-size: 10px;
                border-radius: 0 !important;
            }

            ul.ui-widget {
                font-size: 13px;
                border: 0;
            }

                ul.ui-widget li.ui-menu-item {
                    list-style-image: none;
                    font-family: "Helvetica Neue", HelveticaNeue, helvetica, arial, sans-serif;
                    font-size: 92%;
                    font-weight: 300;
                    font-style: normal;
                    font-size-adjust: none;
                    margin: 0;
                    padding: 1.8px 4.55px;
                    white-space: nowrap;
                }

            .ui-widget-content a {
                color: #444444;
            }



            ul.ui-widget li.ui-menu-item b {
                font-weight: 700;
            }

            #search {
                height: 25px;
            }

            .ui-widget-content .ui-state-focus {
                background-color: #D6F7FF;
                background-image: none;
                border: 0;
            }

            .highlight {
                background-color: #055a87;
                color: #fff;
            }

            a,
            a:hover {
                text-decoration: none;
            }

            body {
                font-family: 'Roboto', sans-serif;
            }

            /*------------------  */
            .ci-user-picture {
                min-width: 150px;
                margin-right: 16px;
            }

                .ci-user-picture img {
                    width: 150px;
                    height: 150px;
                    border-radius: 50%;
                }

            .filepreviewprofile {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
            }

            /*----modal--------*/
            .modal-header-bg {
                width: 100%;
                height: 12px;
                background: #055a87;
            }

            .cropImageModal .modal-dialog {
                max-width: 750px;
                width: 90%;
                margin: 0.5rem auto;
            }

            .up-photo-title {
                padding: 8px 15px;
                text-align: center;
            }

            #upload-demo {
                position: relative;
                width: 100%;
                height: 250px;
                padding-bottom: 0;
            }

            .croppie-container h5 {
                position: absolute;
                bottom: 4px;
                text-align: center;
                left: 0;
                right: 0;
                color: #fff;
                z-index: 2;
                font-size: 15px;
            }

            figure figcaption {
                position: absolute;
                bottom: 0;
                color: #fff;
                width: 100%;
                padding-left: 9px;
                padding-bottom: 5px;
                text-shadow: 0 0 10px #000;
            }

            .croppie-container .cr-image {
                right: 0;
            }

            .croppie-container .cr-slider-wrap {
                width: 275px;
            }

            .cr-slider-wrap p {
                font-size: 13px;
                color: #8D8D94;
                text-align: left;
            }

            .cr-slider {
                width: 275px;
            }

            .upload-action-btn {
                margin-top: 60px;
                padding-top: 40px;
            }

            .cr-slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 18px;
                height: 18px;
                background: #006AFA;
                cursor: pointer;
                box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.25);
            }

            .cr-slider::-moz-range-thumb {
                width: 18px;
                height: 18px;
                background: #006AFA;
                cursor: pointer;
                box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.25);
            }

            .cr-slider::-ms-thumb {
                width: 18px;
                height: 18px;
                background: #006AFA;
                cursor: pointer;
                box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.25);
            }

            .cr-slider::-webkit-slider-runnable-track {
                width: 275px;
                height: 2px;
                cursor: pointer;
                box-shadow: none;
                background: #E0E0E0;
                border-radius: 3px;
                border: none;
            }

            .cr-slider:focus::-webkit-slider-runnable-track {
                background: #E0E0E0;
            }

            .cr-slider::-moz-range-track {
                width: 275px;
                height: 2px;
                cursor: pointer;
                box-shadow: none;
                background: #E0E0E0;
                border-radius: 3px;
                border: none;
            }

            .cr-slider::-ms-track {
                width: 275px;
                height: 2px;
                cursor: pointer;
                box-shadow: none;
                background: #E0E0E0;
                border-radius: 3px;
                border: none;
                color: transparent;
            }

            #ui-datepicker-div {
                position: fixed;
                top: 268.75px;
                left: 308px;
                z-index: 1000;
                display: block;
            }

            /* start */

            .dropdown-submenu > .dropdown-menu {
                display: none;
                position: absolute;
                top: 0;
                left: 100%;
                min-width: 330px !important; /* 🔥 Force width */
                width: 400px !important; /* 🔥 Force apply width */
                z-index: 9999;
                max-height: 400px; /* 500px ke baad scroll start hoga */
                overflow-y: auto; /* vertical scrollbar enable */
                overflow-x: hidden;
            }

            .dropdown-submenu:hover > .dropdown-menu {
                display: block;
            }

            .dropdown-submenu > .dropdown-menu {
                z-index: 9999;
            }

            .dropdown-toggle::after {
                display: none !important;
            }

            .dropdown-menu .dropdown-item {
                padding-top: 5px;
                padding-bottom: 5px;
                line-height: 1.2;
            }

            .dropdown-menu {
                position: absolute; /* ya fixed, use-case ke hisaab se */
                z-index: 9999; /* sab se upar laane ke liye bada z-index */
            }

            .favMenu.highlight {
                border: 2px dashed #4caf50;
                background-color: rgba(76, 175, 80, 0.1);
                transition: all 0.2s ease-in-out;
            }

            .slide-track-custom {
                background-color: #055a87;
                clip-path: polygon(20px 0%, 100% 0%, 100% 100%, 0% 100%);
                color: white;
                overflow: hidden;
                display: inline-block;
                padding: 3px 12px;
            }


            .branch-name-custom {
                color: white !important;
                white-space: nowrap !important;
                font-size: 11px !important;
                letter-spacing: 1px !important;
                visibility: visible !important;
            }

            /* breadcrumb */

            .breadcrumb-box {
                text-align: left;
            }

            .breadcrumb-custom {
                background-color: #055a87;
                /* clip-path: polygon(0% 0%, 100% 0%, 90% 100%, 0px 100%); */
                clip-path: polygon(0px 0px, 100% 0%, calc(100% - 20px) 100%, 0px 100%);
                color: white;
                overflow: hidden;
                display: inline-block;
                padding: 7px 40px 0px 12px;
                margin: 0;
            }

                .breadcrumb-custom li {
                    color: white;
                    font-size: 11px;
                    letter-spacing: 1px;
                    white-space: nowrap;
                }

                .breadcrumb-custom a {
                    color: white;
                    text-decoration: none;
                }

            /* KnockOff modal */
            .modal-dialog.knockoff-modal {
                max-width: 60%;
                width: 95%;
                height: 75%; /* Add this */
                margin: 0 auto; /* Center vertically */
                margin-top: 3rem; /* Center vertically */
            }

            .modal-content {
                height: 100%; /* Add this */
                display: flex;
                flex-direction: column;
            }

            #knockOffModal .modal-body {
                overflow-y: auto;
                flex: 1; /* This will make modal-body take remaining space */
            }

            .dx-revert-button {
                display: none !important;
            }

            .gear-dropdown {
                display: none;
                position: absolute !important;
                background: #fff;
                border: 1px solid #ddd;
                border-radius: 8px;
                padding: 15px 20px;
                width: 240px !important;
                max-width: 350px;
                z-index: 9999;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15); /* Softer, larger shadow */
                transition: opacity 0.2s ease, transform 0.2s ease;
                /* opacity: 0; /* start hidden */ */ transform: translateY(-10px); /* slight upward offset for animation */
            }


                .gear-dropdown .form-check {
                    padding-left: 0;
                }

                .gear-dropdown .form-check-label {
                    margin-left: 0.5rem;
                }

            .breadcrumb-box, .breadcrumb {
                overflow: visible !important; /* ensure dropdown is visible */
            }

            .dclear-chk {
                margin-left: 4.5em !important;
            }


            .gear-checkbox {
                width: 13px;
                height: 13px;
                transform: scale(1.3);
                margin-left: 1.1em;
                accent-color: var(--theme-deafult);
                cursor: pointer;
            }

            .negative-summary {
                color: red;
                font-weight: 600;
            }

        </style>
    </environment>
    @if (IsSectionDefined("LinkStyleSection"))
    {
        @RenderSection("LinkStyleSection")
        ;
    }
    @if (IsSectionDefined("InLineStyleSection"))
    {
        @RenderSection("InLineStyleSection")
        ;
    }
</head>

