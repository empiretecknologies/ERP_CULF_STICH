<div class="card">
    <div class="card-header">
        <button type="button" id="BtnNew" style="display:none" class="btn btn-primary btn-new waves-effect waves-light float-end"><i class="fa fa-plus"></i> Add New</button>
    </div>
    <div class="card-body Record">
        <input type="hidden" id="branchhidden" />
        <div class="row">
            <div class="col-xl-2">
                <label class="form-label" for="Code">Code</label>
                <input class="form-control" id="Code" readonly type="text" autocomplete="off">
            </div>
            <div class="col-xl-2">
                <label class="form-label" for="ASTATUS">Status</label>
                <div id="ASTATUS"></div>
            </div>
            <div class="col-xl-8 mb-1">
                <label class="form-label" for="DESCR">Description</label>
                <input class="form-control" id="DESCR" type="text" autocomplete="off">
            </div>
            <div class="col-xl-3 mb-1">
                <label class="form-label" for="START_D">Start Date</label>
                <input class="form-control" type="date" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" id="START_D" autocomplete="off">
            </div>
            <div class="col-xl-3 mb-1">
                <label class="form-label" for="START_E">End Date</label>
                <input class="form-control" id="START_E" type="date" autocomplete="off">
            </div>
            <div class="col-xl-4 mb-1">
                <label class="form-label" for="BCODE">Branch</label>
                <div id="BCODE"></div>
            </div>
            <div class="col-xl-2 mb-1">
                <label class="form-label" for="CLOSING">Closing :</label>
                <div class="form-check form-switch">
                    <input class="form-check-input" id="flexSwitchCheckDefault" type="checkbox">
                </div>
            </div>
            <div class="col-xl-12 text-end">
                <button class="btn btn-danger btn-delete" style="display:none" id="BtnDelete"><i class="fa fa-trash"></i> Delete</button>
                <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card text-left">
                <div class="card-body">
                    <div class="table-responsive">
                        <div id="gridContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section LinkScriptSection{
    <script src="~/js/customjs/empr_Period.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        var Branch = @Html.Raw(Json.Serialize(ViewBag.Branch));
        $(function () {
            empr_Period.initEvents();
        });
    </script>
}