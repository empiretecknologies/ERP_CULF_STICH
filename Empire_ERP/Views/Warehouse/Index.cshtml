<div class="card">
    <div class="row">
        <div class="col-md-8">
            <div class="card-header">
                <button type="button" id="QuickSearch" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl"><i class="fa fa-search"></i> Quick Search</button>
                <button type="button" id="BtnNew" style="display:none" class="btn btn-primary btn-new waves-effect waves-light float-end"><i class="fa fa-plus"></i> Add New</button>
            </div>
            <div class="card-body pt-1 Record">
                <div class="row">
                    <div class="col-xl-4">
                        <label class="form-label" for="Code">Code:</label>
                        <input class="form-control" id="Code" readonly type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-4">
                        <label class="form-label" for="ASTATUS">Status:</label>
                        <div id="ASTATUS"></div>
                    </div>
                    <div class="col-xl-4">
                        <label class="form-label" for="GROUP_TYPE">Type:</label>
                        <div id="GROUP_TYPE"></div>
                    </div>
                    <div class="col-xl-12">
                        <label class="form-label" for="DESCR">Name:</label>
                        <input class="form-control" id="DESCR" type="text" autocomplete="off">
                    </div>
                    <span class="span name-validation"></span>
                    <div class="col-xl-12">
                        <label class="form-label" for="PARENT_CODE">Control Name:</label>
                        <div id="PARENT_CODE"></div>
                    </div>
                    <div class="col-xl-4 Dynamic" style="display:none">
                        <label class="form-label" for="CONTACT_PERSON">Contact Person:</label>
                        <input class="form-control" id="CONTACT_PERSON" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-4 Dynamic" style="display:none">
                        <label class="form-label" for="CELL">Cell No:</label>
                        <input class="form-control ContactNo" id="CELL" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-4 Dynamic" style="display:none">
                        <label class="form-label" for="TELL">Telephone No:</label>
                        <input class="form-control ContactNo" id="TELL" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-12 mb-1 Dynamic" style="display:none">
                        <label class="form-label" for="ADDR">Address:</label>
                        <input class="form-control" id="ADDR" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-12 text-end mt-10">
                        <button class="btn btn-danger btn-delete" id="BtnDelete" style="display:none"><i class="fa fa-trash"></i> Delete</button>
                        <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-left">
                <div class="card-body">
                    <div class="table-responsive">
                        <div id="treeListContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--  Extra Large modal example -->
    <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Quick Search</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <div id="gridContainer"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->
</div>

<input type="hidden" id="ACT_PARENT_CODE_hidden" />
<input type="hidden" id="displayExprcontrol" />

@section LinkScriptSection{
    <script type="text/javascript">
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        $(function () {
            empr_Warehouse.InitEvents();
        });
    </script>
    <script src="~/js/customjs/empr_Warehouse.js" asp-append-version="true"></script>
}