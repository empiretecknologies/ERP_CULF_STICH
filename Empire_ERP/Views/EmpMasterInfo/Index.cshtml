<div class="card">
    <div class="card-header">
        <input type="hidden" id="MasterId" />
        <div class="d-flex emp-responsive-toolbar" style="justify-content: space-between;width: 100%;gap: 10px;">
            @* <label class="form-label" for="EducatioID">Employee:</label> *@
            <input type="hidden" id="ACT_GROUP_hidden" />
            <input type="hidden" id="displayExprAccGroup" />
            <div style="width:600px;max-width:100%;height:20px;padding: 4px;"><div id="ENAME"></div></div>
            <div style="width:300px;max-width:100%;height:20px;padding: 4px;"><div id="TNAME"></div></div>
            
            <button type="button" id="BtnNew" class="btn btn-primary btn-new waves-effect waves-light " style="height: 24px;width: 95px;margin-top: 3px;">
                ->| GO
            </button>
            <button type="button" id="resetForm" class="btn btn-primary btn-new waves-effect waves-light " style="height: 24px ;margin-left: 165px;margin-top: 3px;">
                Add New
            </button>
            <button class="btn btn-primary btn-refresh" id="refresh" style="    width: 100px;height: 23px;margin-top: 2px;padding: 2px;">
                <i class="fa fa-refresh"></i>
                Refresh
            </button>
        </div>
    </div>
    <div class="card-body Record">
        <div class="row">
            <div class="col-xl-2  mb-1 Code">
                <label class="form-label" for="Code">Code:</label>
                <input class="form-control" id="Code" readonly type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1 Status">
                <label class="form-label" for="ASTATUS">Status:</label>
                <div id="ASTATUS"></div>
            </div>
            <div class="col-xl-4 mb-1" id="StartDs">
                <label class="form-label" for="StartD">Start Date:</label>
                <input class="form-control" id="StartD" type="date" autocomplete="off">
            </div>
            <div class="col-xl-3 mb-1" id="EndDs">
                <label class="form-label" for="EndD">End Date:</label>
                <input class="form-control" id="EndD" type="date" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="CNames">
                <label class="form-label" for="CName">Company Name:</label>
                <input class="form-control" id="CName" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="DecStarts">
                <label class="form-label" for="DecStart"> Joining Description:</label>
                <input class="form-control" id="DecStart" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="DecEnds">
                <label class="form-label" for="DecEnd">Left Description:</label>
                <input class="form-control" id="DecEnd" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="InitialSalarys">
                <label class="form-label" for="InitialSalary">Initial Salary:</label>
                <input class="form-control" id="InitialSalary" type="number" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="FinalSalarys">
                <label class="form-label" for="FinalSalary">Final Salary:</label>
                <input class="form-control" id="FinalSalary" type="number" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="CellNos">
                <label class="form-label" for="CellNo">Cell No:</label>
                <input class="form-control" id="CellNo" type="number" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="LReasons">
                <label class="form-label" for="LReason">Leave Reason:</label>
                <input class="form-control" id="LReason" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="WADDs">
                <label class="form-label" for="WADD">Work Address:</label>
                <input class="form-control" id="WADD" type="text" autocomplete="off">
            </div>
            <div class="col-xl-4 mb-1" id="EducatioIDs">
                <label class="form-label" for="EducatioID">Education:</label>
                <div id="EducatioID"></div>
            </div>
            <div class="col-xl-2 mb-1" id="MSubjects">
              <label class="form-label" for="MSubject">Major Subject:</label>
              <input class="form-control" id="MSubject" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="EYears">
                <label class="form-label" for="EYear">Ending Year:</label>
                <input class="form-control" id="EYear" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="GBatchs">
                <label class="form-label" for="GBatch">Group Batch:</label>
                <input class="form-control" id="GBatch" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="Institutes">
                <label class="form-label" for="Institute">Institute:</label>
                <input class="form-control" id="Institute" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="G_CGPAS">
                <label class="form-label" for="G_CGPA">GRADE/CGPA:</label>
                <input class="form-control" id="G_CGPA" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="EduDocs">
                <label class="form-label" for="EduDoc">Document:</label>
                <input class="form-control" id="EduDoc" type="file" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="WDates">
                <label class="form-label" for="WDate">Workshop Date:</label>
                <input class="form-control" id="WDate" type="date" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="Titles">
                <label class="form-label" for="Title">Title:</label>
                <input class="form-control" id="Title" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="WorkRemarks">
                <label class="form-label" for="WorkRemark">Remarks:</label>
                <input class="form-control" id="WorkRemark" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="WorkDocs">
                <label class="form-label" for="WorkDoc">Document:</label>
                <input class="form-control" id="WorkDoc" type="file" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="BasicSalarys">
                <label class="form-label" for="BasicSalary">Basic Salary:</label>
                <input class="form-control" id="BasicSalary" type="number" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="HouseRents">
                <label class="form-label" for="HouseRent">House Rent:</label>
                <input class="form-control" id="HouseRent" type="number" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="UTILITYS">
                <label class="form-label" for="UTILITY">Utility:</label>
                <input class="form-control" id="UTILITY" type="number" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="COLAS">
                <label class="form-label" for="COLA">Cola:</label>
                <input class="form-control" id="COLA" type="number" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="EFFDates">
                <label class="form-label" for="EFFDate">EFF Date:</label>
                <input class="form-control" id="EFFDate" type="date" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="EmpRemarks">
                <label class="form-label" for="EmpRemark">Remarks:</label>
                <input class="form-control" id="EmpRemark" type="text" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1" id="EmpDocs">
                <label class="form-label" for="EmpDoc">Document:</label>
                <input class="form-control" id="EmpDoc" type="file" autocomplete="off">
            </div>
            <span class="span name-validation"></span>
            <div class="col-xl-12 text-end">
                <button class="btn btn-danger btn-delete" style="display:none" id="BtnDelete"><i class="fa fa-trash"></i> Delete</button>
                <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card text-left">
                <div class="card-body">
                    <div class="table-responsive">
                        <div id="gridContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section LinkScriptSection{
    <script type="text/javascript">
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        var EmpMasterInfoTables = @Html.Raw(Json.Serialize(ViewBag.EmpMasterInfoTables));
        var EducationRecords = @Html.Raw(Json.Serialize(ViewBag.EducationRecords));
    </script>
    <script src="~/js/customjs/empr_EmpMasterInfo.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            empr_EmpMasterInfo.initEvents();
        });
    </script>
}