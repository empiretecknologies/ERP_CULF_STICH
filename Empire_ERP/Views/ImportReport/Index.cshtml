<div class="card">
	<div class="card-header">
		<input class="form-control" id="HIDDEN_FROM_DATE" type="hidden" value="@ViewBag.StartDate" autocomplete="off">
		<input class="form-control" id="HIDDEN_TO_DATE" type="hidden" value="@ViewBag.EndDate" autocomplete="off">
		<div class="row">
			<div class="col-xl-2">
				<label class="form-label" for="FROM_DATE">From Date:</label>
				<input class="form-control" id="FROM_DATE" type="date" value="@ViewBag.StartDate" autocomplete="off">
			</div>
			<div class="col-xl-2">
				<label class="form-label" for="TO_DATE">To Date:</label>
				<input class="form-control" id="TO_DATE" type="date" value="@ViewBag.EndDate" onchange="empr_helper.validateDate()" autocomplete="off">
			</div>
			<div class="col-xl-2">
				<label class="form-label" for="CONTROL_NAME">Control :</label>
				<div id="CONTROL"></div>
			</div>
			<div class="col-xl-2">
				<label class="form-label" for="ACCOUNT_NAME">Subsidiary :</label>
				<div id="SUBSIDIARY"></div>
			</div>
			<div class="col-xl-4">
				<button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end mt-3" id="BtnGenerate">
					<i class="fa fa-print"></i> Generate Report
				</button>
			</div>
		</div>
	</div>
	<div class="card-body pt-1 Record TabsDiv">
		<ul class="nav nav-tabs nav-primary" id="Tab" role="tablist">
			<li class="nav-item"><a class="nav-link active" id="OptionTab" data-bs-toggle="pill" href="#OptionTabContent" role="tab" aria-controls="pills-warninghome" aria-selected="true">REPORT SELECTION</a></li>
			@* <li class="nav-item"><a class="nav-link" id="ViewTab" data-bs-toggle="pill" href="#ViewTabContent" role="tab" aria-controls="pills-warningprofile" aria-selected="false">REPORT VIEW</a></li> *@
		</ul>
		<div class="tab-content" id="pills-warningtabContent">
			<div class="tab-pane fade show active" id="OptionTabContent" role="tabpanel" aria-labelledby="pills-warninghome-tab">
				<div class="row">
					<div class="col-xl-6 mt-3">
						@* <label class="breadcrumb-item reportHeading" for="MENU_NAME">@ViewBag.MENU_NAME:</label> *@
						<label class="breadcrumb-item reportHeading position-static" for="MENU_NAME">@ViewBag.MENU_NAME:</label>
						<div id="GridContainer"></div>
					</div>
					<div class="col-xl-3 mt-50">
						@* <div class="row">
							<div class="col-xl-12">
								<label class="form-label" for="CONTROL_NAME">Control :</label>
								<div id="CONTROL"></div>
							</div>
						</div>
						<div class="row">
							<div class="col-xl-12">
								<label class="form-label" for="ACCOUNT_NAME">Subsidiary :</label>
								<div id="SUBSIDIARY"></div>
							</div>
						</div> *@
					</div>
				</div>

			</div>
			<div class="tab-pane fade Detail" id="ViewTabContent" role="tabpanel" aria-labelledby="pills-warningprofile-tab">
				<div class="row mt-3 ml-5">
					<ul class="nav nav-tabs nav-primary" id="Tab" role="tablist">
						<li class="nav-item"><a class="nav-link active reportTab" id="REPORT_NAME" data-bs-toggle="pill" href="#ViewReport" role="tab" aria-controls="pills-warninghome" aria-selected="true">REPORT</a></li>
					</ul>
					<div class="tab-content" id="pills-warningtabContent">
						<div class="tab-pane mt-3 fade show active" id="ViewReport" role="tabpanel" aria-labelledby="pills-warninghome-tab">
							<div id="ReportGridContainer"></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="modal fade bs-example-modal-xl" id="ShowReportModal" style="display:none" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="myExtraLargeModalLabel">Print Report</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				@* <div class="col-md-10">
                    <div class="row">
                        <div class="col-xl-4">
                            <label class="form-label" for="ReportType">ReportType:</label>
                            <div id="ReportType"></div>
                        </div>
                        <div class="col-xl-2 mt-20">
                            <button type="button" class="btn btn-primary mr-5" data-bs-toggle="modal" id="BtnGenerateReport">
                                <i class="fa fa-file-arrow-down"></i> Get Report
                            </button>
                        </div>
                    </div>
                </div> *@
				<div class="col-md-12 mt-3">
					<div class="card text-left" id="ModalBody"></div>
				</div>
			</div>
		</div>
	</div>
</div>


@section LinkScriptSection {
	<script type="text/javascript">
		var controls = @Html.Raw(Json.Serialize(ViewBag.Controls));
		var subsidiary = @Html.Raw(Json.Serialize(ViewBag.Subsidiary));
	</script>
	<script type="text/javascript">
		empr_helper.companyName = @Html.Raw(Json.Serialize(ViewBag.CompanyName));
		$(function () {
			empr_ImportReports.InitEvents();
		});
	</script>
	<script src="~/js/customjs/empr_ImportReports.js" asp-append-version="true"></script>
}