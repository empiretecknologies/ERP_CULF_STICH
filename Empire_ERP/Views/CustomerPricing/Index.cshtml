<div class="card">
    <div class="card-header">
        <button type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal"
                data-bs-target=".bs-example-modal-xl" id="BtnQuickSearch">
            <i class="fa fa-search"></i> Quick Search
        </button>
        <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnNew">
            <i class="fa fa-plus"></i> Add New
        </button>
    </div>
    <div class="card-body Record">
        <div class="row">
            <input id="ID" hidden />
            <div class="col-xl-3">
                <label class="form-label" for="Code">Code:</label>
                <input class="form-control" id="Code" readonly type="text" autocomplete="off">
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="ASTATUS">Status:</label>
                <div id="ASTATUS"></div>
            </div>
            @* <div class="col-xl-3 SalesMans">
                <label class="form-label" for="SalesMan">Salems Men:</label>
                <div id="SalesMan"></div>
            </div> *@
            <div class="col-xl-3 SalesMans">
                <label class="form-label" for="SalesMan">Party Type:</label>
                <div id="PARTY_CODE"></div>
            </div>

            <ul class="nav nav-tabs nav-primary mt-4    " id="pills-warningtab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="pills-warninghome-tab" data-bs-toggle="pill"
                       href="#pills-warninghome" role="tab" aria-controls="pills-warninghome" aria-selected="true">
                        Detail
                        Info
                    </a>
                </li>
            </ul>
            <div class="tab-content mt-4" id="pills-warningtabContent">
                <div class="tab-pane fade show active" id="pills-warninghome" role="tabpanel"
                     aria-labelledby="pills-warninghome-tab">
                    <div class="table-responsive">
                        <div id="DetailContainer" style="width:100%;"></div>
                    </div>
                </div>
            </div>
        </div>
        <input class="form-control" id="ACT_CODE" type="hidden" readonly autocomplete="off">
        <input class="form-control" id="UNITTYPE" type="hidden" readonly autocomplete="off">
        <input class="form-control" id="RATE" type="hidden" readonly autocomplete="off">




        <div class="col-xl-12 text-end pt-5 pb-10 pr-15">
            <button class="btn btn-danger btn-delete" id="BtnDelete" style="display:none"><i class="fa fa-trash"></i> Delete</button>
            <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
        </div>



        <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
             aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="myExtraLargeModalLabel">Quick Search</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="col-md-12">
                            <div class="card text-left">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <div id="gridContainer"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div>
    </div>


@section LinkScriptSection {

        <script type="text/javascript">

            var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
            var Limit = @Html.Raw(Json.Serialize(ViewBag.Limit));
            var dataClear = @Html.Raw(Json.Serialize(ViewBag.DATA_CLEAR));
            var PartyType = @Html.Raw(Json.Serialize(ViewBag.PartyType));

            var ItemMaster= @Html.Raw(Json.Serialize(ViewBag.ItemMaster));



        </script>
        <script src="~/js/customjs/empr_CustomerPricing.js" asp-append-version="true"></script>
        <script type="text/javascript">
            $(function () {
                // consoler.log("salesman", salesMans);
                //   consoler.log("items", ItemMaster);
                empr_CustomerPricing.DC_TYPE = @Html.Raw(Json.Serialize(ViewBag.DC_TYPE));
                empr_CustomerPricing.InitEvents();
                empr_helper.EnableShortCutKeys('#BtnSave', '#BtnNew', '#BtnDelete', '#BtnQuickSearch', '#Code', '#DetailContainer', 0, 'custoM_ACT_CODE');
            });
        </script>
}
