@model Empire_ERP.Core.Entities.SlipViewModel

<div style="max-width:72mm;font-size:0.8rem !important; font-weight: 400; font-family: 'Poppins', sans-serif;">

    <div style="text-align: center;">
        <img src="~/Client/Company/@Model.Clogo" alt="Company Logo" style="width: 150px;"><br />
        <b>@Model.BName</b><br />
        <b>@Model.BAddress</b><br />
        <b>@Model.BPhone</b>
    </div>
    <div style="display: flex; justify-content: center; width: 100%;">
        <img class="qr-code" src="POSTransactions/GenerateQRCode?invoiceNumber=@Model.ReferenceNumber" alt="QR Code" style="width: 100px;" />
    </div>
    <div style="font-size:0.9rem !important; font-weight: 400; display: flex; flex-direction: column; width: 100%;">
        <div style="display: flex;width: 100%;">
            <b>REF #: </b> <span>@Model.ReferenceNumber</span>
        </div>

        <div style="display: flex; width: 100%;">
            <b>DATE: </b> <span>@Model.Date @Model.Time</span>
        </div>

        <div style="display: flex; width: 100%;">
            <b>CUSTOMER: </b> <span>@Model.CustomerName</span>
        </div>

        <div style="display: flex; width: 100%;">
            <b>CONTACT #: </b> <span>@Model.ContactNumber</span>
        </div>

        <div style="display: flex; width: 100%;">
            <b>SALESMAN: </b> <span>@Model.SalesmanName</span>
        </div>
    </div>

    <div style="width: auto; background-color: black !important;color: white; text-align: center;">
        <span style="font-weight: bold; font-size: 25px;">SALES RECEIPT</span>
    </div>

    <br />

    <div>

        <table style="font-size:0.8rem !important; font-weight: 400;border-collapse: collapse;">
            <thead style="background-color: white !important; color :black !important;">
                <tr>
                    <th style="text-align: center;border :0.5px dotted !important;">Description</th>
                    <th style="text-align: center;border :0.5px dotted !important;">Qty</th>
                    <th style="text-align: center;border :0.5px dotted !important;">Price</th>
                    <th style="text-align: center;border :0.5px dotted !important;">Disc %</th>
                    <th style="text-align: center;border :0.5px dotted !important;">Amount</th>
                </tr>
            </thead>
            <tbody id="body">
                @if (Model.Items != null)
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td colspan="5" style="text-align: left; white-space: nowrap;">@item.Description</td>
                        </tr>
                        <tr>
                            <td style="text-align: center;">@item.BARCODE</td>
                            <td style="text-align: center;">@item.Quantity</td>
                            <td style="text-align: center;">@(item.Price?.ToString("N0") ?? "0")</td>
                            <td style="text-align: center;">@item.Discount</td>
                            <td style="text-align: right;">@(item.Amount?.ToString("N0") ?? "0")</td>
                        </tr>
                    }
                }

            </tbody>
        </table>

    </div>

    <hr style="border: 1px solid black;">

    <div style="font-size:0.8rem !important; font-weight: 400; width: 100%; text-align: left;">
        <span style="float: left;">BILL DISC: </span><span style="text-align:center;">@Model.DiscountPercentage %</span> <span style="float: right;">(@Model.RoundingDiscount)</span><br />
        @* @if (Model.BANK_TAX != null && Model.PARTY_TAX != null) *@
        @if (Model.PAYTYPE == "Split")
        {
            <span style="float: left;"> SPLIT TAX : </span> <span style="text-align:center;">@Model.TAX_CASH %</span> <span style="float: right;">@Model.CASHTAX_AMT</span>

            @* <br />
            <span style="float: left;">BANK TAX : </span>

            <span style="text-align:center;">@Model.BANK_TAX %</span> <span style="float: right;">@Model.BANKTAX_AMT</span>

            <br />
            <span style="float: left;">PARTY TAX : </span>

            <span style="text-align:center;">@Model.PARTY_TAX %</span> <span style="float: right;">@Model.PARTYTAX_AMT</span> *@


        }
        @* else if (Model.BANK_TAX != null) *@
        else if (Model.PAYTYPE == "Bank")
        {
            <span style="float: left;">BANK TAX : </span>

            <span style="text-align:center;">@Model.BANK_TAX %</span> <span style="float: right;">@Model.BANKTAX_AMT</span>


        }
        @* else if (Model.PARTY_TAX != null) *@
        else if (Model.PAYTYPE == "Party")
        {
            <span style="float: left;">PARTY TAX : </span>

            <span style="text-align:center;">@Model.PARTY_TAX %</span> <span style="float: right;">@Model.PARTYTAX_AMT</span>


        }
        @* else if (Model.TAX_CASH != null) *@
        else if (Model.PAYTYPE == "Cash")
        {
            <span style="float: left;"> CASH TAX : </span> <span style="text-align:center;">@Model.TAX_CASH %</span> <span style="float: right;">@Model.CASHTAX_AMT</span>

        }
  
        @* <span style="float: left;">TAX : </span><span style="text-align:center;">@Model.TAX %</span> <span style="float: right;">@Model.TotalTax</span><br /> *@
        @if (Model.Sett != 0 && Model.Sett != null)
        {
            <br />
            <span style="float: left;">SETTLEMENT: </span> <span style="text-align:center;"> </span> <span style="float: right;">(@Model.Sett)</span><br />
        }
        <div style="width: auto; background-color: black; color:white;">
            <span style="float: left; font-weight: bold;">INVOICE VALUE: </span> <span style="float: right;"><b>@Model.TotalAmountFormatted</b></span><br />
        </div>
    </div>
    <br />
    @if (Model.billStatus == "P")
    {
        <div style="width: auto; border: 0.5px dotted !important; text-align: center;">
            <span style="font-weight: bold; font-size: 25px;">PAYMENTS</span>
        </div>

        <div style="font-size:0.8rem !important; font-weight: 400; width: 100%; text-align: left;">
            @* @if (Model.CashFormatted != "0") *@
            @if (Model.PAYTYPE == "Cash" || Model.PAYTYPE == "Split")
            {
                <b style="float: left; font-weight: bold;">CASH: </b>
                <span style="float: right;"><b>@Model.CashFormatted</b></span>

                <br />
                <span style="float: left;">CASH BACK: </span>
                <span style="float: right;">@Model.CashBack</span>

                <br />
            }
            @* @if (Model.Bank != 0) *@
            @if (Model.PAYTYPE == "Bank" || Model.PAYTYPE == "Split")
            {
                <b style="float: left; font-weight: bold;">BANK: </b>
                <span style="float: right;"><b>@Model.BankFormatted</b></span>

                <br />
            }
            @* @if (Model.Party != 0) *@
            @if (Model.PAYTYPE == "Party" || Model.PAYTYPE == "Split")
            {
                <b style="float: left; font-weight: bold;">PARTY: </b>
                <span style="float: right;"><b>@Model.PartyFormatted</b></span>

                <br />
            }

            @* If nothing is shown above, show fallback *@
            @if (Model.CashFormatted == "0" && Model.Bank == 0 && Model.Party == 0)
            {
                <span style="float: left; font-weight: bold;">CASH: </span>
                <span style="float: right;"><b>@Model.CashFormatted</b></span>

                <br />
                <span style="float: left;">CASH BACK: </span>
                <span style="float: right;">@Model.CashBack</span>

                <br />
            }
        </div>

        <hr style="border: 1px solid black;">
    }

    <div style="font-size:0.9rem !important; font-weight: 400;">
        <div style="width: auto;text-align: center;">
            <span style="font-weight: bold; font-size: 20px;">TERMS & CONDITIONS</span>
        </div>
        <p style="font-size: 11px; text-align: center; margin: 0;">
            @Model.MENUTERMS
        </p>
        <div style="font-size: 11px; margin-top: 5px;">
            <div style="margin-bottom: 2px;">
                <img src="~/icons/facebook.svg" width="12" style="vertical-align: middle;" /> @Model.FBLINK

            </div>
            <div style="margin-bottom: 2px;">
                <img src="~/icons/instagram.svg" width="12" style="vertical-align: middle;" />
                @Model.INSTALINK
            </div>
            <div style="margin-bottom: 2px;">
                <img src="~/icons/googlechrome.svg" width="12" style="vertical-align: middle;" />
                @Model.WEBLINK
            </div>
            <div style="margin-bottom: 2px;">
                <img src="~/icons/tiktok.svg" width="12" style="vertical-align: middle;" />
                @Model.TIKTOKLINK
            </div>
            <div style="margin-bottom: 2px;">
                <img src="~/icons/youtube.svg" width="12" style="vertical-align: middle;" />
                @Model.YOUTUBELINK
            </div>
        </div>
        @if (Model.WIFIPASS != "")
        {
            <!-- Free Wi-Fi QR -->
            <div style="text-align: center; margin-top: 8px;">
                <p style="font-size: 11px; margin: 0;">Free Wi-Fi</p>
                <img src="/POSTransactions/GenerateWiFiQRCode?ssid=@Model.WIFINAME&password=@Model.WIFIPASS&encryption=WPA"
                     alt="Scan to Connect to WiFi"
                     style="width: 80px; height: 80px; border: 1px solid #eee;" />
                <p style="font-size: 9px; margin: 0;">Password: @Model.WIFIPASS</p>
            </div>
        }
       
    </div>
    <hr style="border: 0.5px dotted;">
    <div style="text-align: center;font-size:0.9rem !important; font-weight: 400;">
        <p>
            Software Designed By: @Model.FName <br />
            @Model.FTEL <br />
            @Model.FWebsite
        </p>
    </div>

</div>



