<style>
    .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused) > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused) > tr > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused):hover > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused):hover > tr > td {
        background-color: #055a87 !important;
        color: white;
    }
</style>
<div class="card">
    <div class="card-header">
        <input class="form-control" id="HIDDEN_FROM_DATE" type="hidden" value="@ViewBag.StartDate" autocomplete="off">
        <input class="form-control" id="HIDDEN_TO_DATE" type="hidden" value="@ViewBag.EndDate" autocomplete="off">
        <div class="row">
            <div class="col-xl-3">
                <label class="form-label" for="FROM_DATE">From Date:</label>
                <input class="form-control" id="FROM_DATE" type="date" 
                @* value="@ViewBag.StartDate"  *@
                       value="@DateTime.Now.ToString("yyyy-MM-dd")"
                autocomplete="off">
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="TO_DATE">To Date:</label>
                @* <input class="form-control" id="TO_DATE" type="date" value="@ViewBag.EndDate" onchange="empr_helper.validateDate()" autocomplete="off"> *@
                <input class="form-control" id="TO_DATE" type="date"
                       value="@DateTime.Now.ToString("yyyy-MM-dd")" autocomplete="off">
            </div>
            <div class="col-xl-6">
                <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end mt-3" id="BtnGenerate">
                    <i class="fa fa-print"></i> Generate Report
                </button>
            </div>
        </div>
    </div>
    <div class="card-body pt-1 Record TabsDiv">
        <ul class="nav nav-tabs nav-primary" id="Tab" role="tablist">
            <li class="nav-item"><a class="nav-link active" id="OptionTab" data-bs-toggle="pill" href="#OptionTabContent" role="tab" aria-controls="pills-warninghome" aria-selected="true">REPORT OPTION</a></li>
            <li class="nav-item"><a class="nav-link" id="ViewTab" data-bs-toggle="pill" href="#ViewTabContent" role="tab" aria-controls="pills-warningprofile" aria-selected="false">REPORT VIEW</a></li>
        </ul>
        <div class="tab-content" id="pills-warningtabContent">
            <div class="tab-pane fade show active" id="OptionTabContent" role="tabpanel" aria-labelledby="pills-warninghome-tab">
                <div class="row">
                    <div class="col-xl-6 mt-3">
                        <label class="breadcrumb-item reportHeading position-static" for="MENU_NAME">@ViewBag.MENU_NAME:</label>
                        <div id="GridContainer"></div>
                    </div>
                    <div class="col-xl-6 mt-50">
                        <div class="row">
                            <div class="col-xl-6">
                                <label class="form-label" for="CONTROL_NAME">Control Name:</label>
                                <div id="CONTROL_NAME"></div>
                            </div>

                            <div class="col-xl-6">
                                <label class="form-label" for="NATURE">Nature:</label>
                                <div id="NATURE"></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-6">
                                <label class="form-label" for="PARTY_NAME">Party Name:</label>
                                <div id="PARTY_NAME"></div>
                            </div>
                            <div class="col-xl-6">
                                <label class="form-label" for="CATDDL">Category :</label>
                                <div id="CATDDL"></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-12">
                                <label class="form-label" for="NATURE">Branch:</label>
                                <div id="BRANCH"></div>
                            </div>
                        </div>
                        @* <div class="row">
                            <div class="col-xl-12">
                                <label class="form-label" for="REGION_NAME">Region Name:</label>
                                <div id="REGION_NAME"></div>
                            </div>
                        </div> *@
                        
                        @* <div class="row">
                            <div class="d-flex" style="position:absolute;margin-top: 12px;">
                                <label class="form-label" for="ShortLedger">Short Ledger:</label>
                                <input type="checkbox" style="margin-left:10px;" id="SHORTLEDGER" />
                            </div>
                        </div> *@
                    </div>
                </div>
            </div>
            <div class="tab-pane fade Detail" id="ViewTabContent" role="tabpanel" aria-labelledby="pills-warningprofile-tab">
                <div class="row mt-3 ml-5">
                    @* <label class="breadcrumb-item report-label" id="REPORT_NAME" for="REPORT_NAME"></label> *@
                    <ul class="nav nav-tabs nav-primary" id="Tab" role="tablist">
                        <li class="nav-item"><a class="nav-link active reportTab" id="REPORT_NAME" data-bs-toggle="pill" href="#ViewReport" role="tab" aria-controls="pills-warninghome" aria-selected="true">REPORT</a></li>
                        <li class="nav-item"><a class="nav-link tradeTab" id="ViewTab" data-bs-toggle="pill" href="#ViewTrade" role="tab" aria-controls="pills-warningprofile" aria-selected="false">TRADE</a></li>
                        <li class="nav-item"><a class="nav-link agingTab" id="ViewTab" data-bs-toggle="pill" href="#AgingReport" role="tab" aria-controls="pills-warningprofile" aria-selected="false">Aging Report</a></li>
                    </ul>
                    <div class="tab-content" id="pills-warningtabContent">
                        <div class="tab-pane mt-3 fade show active" id="ViewReport" role="tabpanel" aria-labelledby="pills-warninghome-tab">
                            <div id="ReportGridContainer"></div>
                        </div>
                        <div class="tab-pane mt-3 fade Detail" id="ViewTrade" role="tabpanel" aria-labelledby="pills-warningprofile-tab">
                            <div id="TradeGridContainer"></div>
                        </div>
                        <div class="tab-pane mt-3 fade Detail" id="AgingReport" role="tabpanel" aria-labelledby="pills-warningprofile-tab">
                            <div id="AgingReportGridContainer"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade bs-example-modal-md" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Password required</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body">
                                <div class="input-group" style="min-height:32px !important">
                                    <input class="form-control" type="password" maxlength="8" id="PASS" required="" placeholder="Password">
                                    <div class="input-group-append">
                                        <a href="javascript:;" class="input-group-text" id="show_loginpassword" onclick="ShowPassword($('#PASS'),this)">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="pt-3 text-end">
                                    <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnGenerateReport">
                                        Generate Report
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section LinkScriptSection {
    <script src="~/js/customjs/empr_PartyReports.js" asp-append-version="true"></script>
    <script type="text/javascript">
        empr_helper.companyName = @Html.Raw(Json.Serialize(ViewBag.CompanyName));
        var BranchWithPeriod = @Html.Raw(Json.Serialize(ViewBag.BranchWithPeriod));
        var currentBranch = @Html.Raw(Json.Serialize(ViewBag.currentBranch));
        var Parties = @Html.Raw(Json.Serialize(ViewBag.Parties));
        $(function () {
            empr_PartyReports.InitEvents();
        });
    </script>
}