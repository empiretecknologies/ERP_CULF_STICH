<div class="card">
    <div class="card-header">
        <button type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal"
                data-bs-target=".bs-example-modal-xl" id="BtnQuickSearch">
            <i class="fa fa-search"></i> Quick Search
        </button>
        <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnNew">
            <i class="fa fa-plus"></i> Add New
        </button>
    </div>
    <div class="card-body Record">
        <div class="row">
            <input id="ID" hidden />
            <div class="col-xl-3">
                <label class="form-label" for="Code">Code:</label>
                <input class="form-control" id="Code" readonly type="text" autocomplete="off">
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="ASTATUS">Status:</label>
                <div id="ASTATUS"></div>
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="V_DATE">Transaction Date:</label>
                <input class="form-control" id="V_DATE" type="date" onkeydown="empr_helper.HandleTabFocusToSelectBox(event, '#SellerCode')" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
            </div>
            <div class="col-xl-3 vHide">
                <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label" for="VOUCHER_NO">Transaction #:</label>
                   @*  <div class="form-check form-switch d-flex mb-5">
                        <div style="margin-right: 3rem !important;">
                            <label class="form-label" for="S">Sale</label>
                        </div>
                        <div>
                            <input class="form-check-input" id="P_S" type="checkbox" checked>
                            <label class="form-label" for="P">Purchase</label>
                        </div>
                    </div> *@
                </div>
                <input class="form-control" id="VOUCHER_NO" type="text" readonly autocomplete="off">
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="TYPE">Movement:</label>
                <div id="TYPE"></div>
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="REF">Reference No:</label>
                <input class="form-control" id="REF" type="text" autocomplete="off">
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="SellerCode">Seller Code:</label>
                <div id="SellerCode"></div>
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="BuyerCode">Buyer Code:</label>
                <div id="BuyerCode"></div>
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="BrokerCode">Broker Code:</label>
                <div id="BrokerCode"></div>
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="Condition">Condition:</label>
                <div id="Condition"></div>
            </div>
            <div class="col-xl-1 ConditionDiv" style="display:none">
                <label class="form-label" for="CreditDays">Cr. Days:</label>
                <input class="form-control" id="CreditDays" type="number" min="0" max="3" autocomplete="off" oninput="if(this.value.length > 3) this.value = this.value.slice(0, 3); empr_SodaBookFeeding.AutoCalculateDueDate(this)">
            </div>
            <div class="col-xl-2 ConditionDiv" style="display:none">
                <label class="form-label" for="DueDate">Due Date:</label>
                <input class="form-control" id="DueDate" type="date" autocomplete="off" onkeydown="empr_helper.HandleTabFocus(event, '#REMARKS')" oninput="empr_SodaBookFeeding.AutoCalculateDays(this)">
            </div>
            <div class="col-xl-6">
                <label class="form-label" for="REMARKS">Comment:</label>
                <textarea class="form-control" id="REMARKS" rows="1" type="text" autocomplete="off"></textarea>
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="Type">Type:</label>
                <div id="SBF_TYPE" onkeydown="empr_SodaBookFeeding.MoveFocusToGridShiftTab(event, '#DetailContainer', 0, 'iteM_CODE')"></div>
            </div>

            <div class="col-xl-3" style="margin-top: 13px;">
                <label class="form-label" for="P_SHIP">Partnership:</label>
                <input class="form-check-input" type="checkbox" id="P_SHIP">
            </div>
            <div class="col-xl-3" style="margin-top: 13px;">
                <label class="form-label" for="TRANS_PS">Purchase & Sold:</label>
                <input class="form-check-input" type="checkbox" id="TRANS_PS">
            </div>

            <div class="col-xl-3 ImpExp IndHide">
                <label class="form-label" for="CurrCode">Currency:</label>
                <div id="CURR_CODE"></div>
            </div>
            <div class="col-xl-3 ImpExp IndHide">
                <label class="form-label" for="REF">Rate:</label>
                <input class="form-control" id="CRATE" type="number" autocomplete="off">
            </div>
            <div class="col-xl-3 ImpExp shipDate">
                <label class="form-label" for="SHIP_DATE">Shipment Date: <input id="SHIP_STATUS" type="checkbox" checked="true" /></label>
                <input class="form-control" id="SHIP_DATE" type="month" value="@DateTime.Now.ToString("yyyy-MM")" autocomplete="off">
                @* <input class="form-control" id="SHIP_DATE" type="date" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off"> *@
            </div>
            <div class="col-xl-3 ImpExp">
                <label class="form-label" for="UNIT">Packing:</label>
                <div id="UNIT"></div>
            </div>
            <div class="col-xl-3 ImpExp">
                <label class="form-label" for="SODA_TYPE">Soda Type:</label>
                <div id="SODA_TYPE" onkeydown="empr_helper.MoveFocusToGridShiftTab(event, '#DetailContainer', 0, 'iteM_CODE')"></div>
            </div>
            <div class="col-xl-3 coBroker">
                <label class="form-label " for="BrokerCode">Co Broker Code:</label>
                <div id="coBrokerCode"></div>
            </div>
            <div class="col-x-12 pt-1 text-end">
                <button type="button" class="btn btn-success btn-print waves-effect waves-light float-end">
                    <i class="fa fa-print"></i> Print
                </button>
            </div>
        </div>
        <ul class="nav nav-tabs nav-primary" id="pills-warningtab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="pills-warninghome-tab" data-bs-toggle="pill"
                   href="#pills-warninghome" role="tab" aria-controls="pills-warninghome" aria-selected="true">
                    Detail
                    Info
                </a>
            </li>
        </ul>
        <div class="tab-content" id="pills-warningtabContent">
            <div class="tab-pane fade show active" id="pills-warninghome" role="tabpanel"
                 aria-labelledby="pills-warninghome-tab">
                <div class="table-responsive">
                    <div id="DetailContainer"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-12 text-end pt-5 pb-10 pr-15">
        <button class="btn btn-danger btn-delete" id="BtnDelete" style="display:none"><i class="fa fa-trash"></i> Delete</button>
        <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
    </div>
    <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Quick Search</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <div id="gridContainer"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>
</div>


@section LinkScriptSection{
    <script type="text/javascript">
        var Items = @Html.Raw(Json.Serialize(ViewBag.Items));
        var Units = @Html.Raw(Json.Serialize(ViewBag.Units));
        var Branch_RT_TYPE = @Html.Raw(Json.Serialize(ViewBag.Branch_RT_TYPE));
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        var Limit = @Html.Raw(Json.Serialize(ViewBag.Limit));
        var dataClear = @Html.Raw(Json.Serialize(ViewBag.DATA_CLEAR));
        var todayDate = '@DateTime.Now.Date.ToString("yyyy-MM-dd")';
    </script>
    <script src="~/js/customjs/empr_SodaBookFeeding.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            empr_SodaBookFeeding.Branch_RT_TYPE = Branch_RT_TYPE; 
            empr_SodaBookFeeding.InitEvents();
            empr_helper.EnableShortCutKeys('#BtnSave', '#BtnNew', '#BtnDelete', '#BtnQuickSearch', '#Code', '#DetailContainer', 0, 'iteM_CODE');
        });
    </script>
}