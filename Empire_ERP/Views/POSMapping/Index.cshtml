							<input class="form-control" id="SImg" type="file" onchange=" empr_POSMapping.UploadStickerImg()" accept="image/*" autocomplete="off">
							<div class="input-group-append">
								<a href="javascript:;" class="input-group-text" id="OpenStickerImage" onclick=" empr_POSMapping.OpenStickerImg()">
									<i class="fa fa-eye"></i>
								</a>
							</div>
						</div>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="POS_PRINT_L">Logo Image :</label>
						<input type="hidden" id="POS_PRINT_L" name="POS_PRINT_L" />
						<div class="input-group">
							<input class="form-control" id="POSPRINTL" type="file" onchange=" empr_POSMapping.UploadLogoImg()" accept="image/*" autocomplete="off">

							@* <input class="form-control" id="POSPRINTL"onchange=" empr_POSMapping.UploadLogoImg()" type="file" accept="image/*" autocomplete="off"> *@
							<div class="input-group-append">
								<a href="javascript:;" class="input-group-text" id="OpenLogoImage" onclick="empr_POSMapping.OpenLogoImg()">
									<i class="fa fa-eye"></i>
								</a>
							</div>
						</div>
					</div>
				
					<div class="col-xl-3">
						<label class="form-label" for="FB_LINK">Facebook URL :</label>
						<input type="url" id="FB_LINK" name="FB_LINK" class="form-control" autocomplete="off">
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="INSTA_LINK">Instagram URL :</label>
						<input type="url" id="INSTA_LINK" name="INSTA_LINK" class="form-control" autocomplete="off">
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="WEB_LINK">Website URL :</label>
						<input type="url" id="WEB_LINK" name="WEB_LINK" class="form-control" autocomplete="off">
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="TIKTOK_LINK">Tiktok URL :</label>
						<input type="url" id="TIKTOK_LINK" name="TIKTOK_LINK" class="form-control" autocomplete="off">
