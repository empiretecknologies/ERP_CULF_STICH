            <div class="col-xl-3">
                <label class="form-label" for="BTYPE">Order Type:</label>
                <div id="BTYPE"></div>
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="Currency">Currency:</label>
                <div id="Currency"></div>
            </div>

            <div class="col-xl-3">
                <label class="form-label" for="Rate">Rate:</label>
                <input class="form-control" id="Rate" type="text" autocomplete="off" oninput="empr_helper.EnhancedDecimalFieldValidation(this)">
            </div>



          @*   <div class="col-xl-3">
                <label class="form-label" for="REF">Sales Invoice #:</label>
                <input class="form-control" id="REF" type="text" autocomplete="off">
            </div> *@

            <div class="col-xl-3">
                <label class="form-label" for="DC_NO">Delivery Challan #:</label>
                <input class="form-control" id="DC_NO" type="text" autocomplete="off">
            </div>

            @* <div class="col-xl-3">
                <label class="form-label" for="RINV_NO">R.Inv No:</label>
