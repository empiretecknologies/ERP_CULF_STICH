						<label class="form-label" for="WHATSAPP_ADV">WhatsApp Adv Msg :</label>
						<textarea type="text" id="WHATSAPP_ADV" name="WHATSAPP_ADV" rows="1" class="form-control" autocomplete="off"></textarea>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="WHATSAPP_RTN">WhatsApp Return Msg :</label>
						<textarea type="text" id="WHATSAPP_RTN" name="WHATSAPP_RTN" rows="1" class="form-control" autocomplete="off"></textarea>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="WHATSAPP_CC">WhatsApp Company Msg :</label>
						<textarea type="text" id="WHATSAPP_CC" name="WHATSAPP_CC" rows="1" class="form-control" autocomplete="off"></textarea>
					</div>
					<div class="col-xl-6">
						<label class="form-label" for="WHATSAPP_MSG">WhatsApp Cst Msg :</label>
						<textarea type="text" id="WHATSAPP_MSG" name="WHATSAPP_MSG" rows="1" class="form-control" autocomplete="off"></textarea>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="WHT_ADV_COM">WhatsApp Adv Com Msg :</label>
						<textarea type="text" id="WHT_ADV_COM" name="WHT_ADV_COM" rows="1" class="form-control" autocomplete="off"></textarea>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="WHT_PARTY_MSG">WhatsApp Party Msg :</label>
						<textarea type="text" id="WHT_PARTY_MSG" name="WHT_PARTY_MSG" rows="1" class="form-control" autocomplete="off"></textarea>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="Group_IMG">Group Image :</label>
						<input type="hidden" id="Group_IMG" name="Group_IMG" />
						<div class="input-group">
							<input class="form-control" id="GroupImage" type="file" accept="image/*" autocomplete="off">
							<div class="input-group-append">
								<a href="javascript:;" class="input-group-text" id="OpenGroupImage" onclick="empr_POSMapping.OpenGroupImage()">
									<i class="fa fa-eye"></i>
								</a>
							</div>
						</div>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="Item_IMG">Item Image :</label>
						<input type="hidden" id="Item_IMG" name="Item_IMG" />
						<div class="input-group">
							<input class="form-control" id="ItemImage" type="file" accept="image/*" autocomplete="off">
							<div class="input-group-append">
								<a href="javascript:;" class="input-group-text" id="OpenItemImage" onclick="empr_POSMapping.OpenItemImage()">
									<i class="fa fa-eye"></i>
								</a>
							</div>
						</div>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="Waiter_IMG">Waiter Image :</label>
