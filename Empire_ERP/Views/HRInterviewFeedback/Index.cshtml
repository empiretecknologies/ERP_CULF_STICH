								<span class="star cs_star" data-value="2">★</span>
								<span class="star cs_star" data-value="3">★</span>
								<span class="star cs_star" data-value="4">★</span>
								<span class="star cs_star" data-value="5">★</span>
							</div>
							<span class="cs_selectedRating" id="selectedRating">0</span>
							<div class="cs_emoji" id="emoji">🙂</div>
						</div>
					</div>

					<div class="col-xl-3 hideOnReject">
						<label class="form-label" for="INT_DATE">Technical Skills:</label>
						<div class="rating-container">
							<div class="rating" id="rating">
								<span class="star ts_star" data-value="1">★</span>
								<span class="star ts_star" data-value="2">★</span>
								<span class="star ts_star" data-value="3">★</span>
								<span class="star ts_star" data-value="4">★</span>
								<span class="star ts_star" data-value="5">★</span>
							</div>
							<span class="ts_selectedRating" id="selectedRating">0</span>
							<div class="ts_emoji" id="emoji">🙂</div>
						</div>
					</div>

					<div class="col-xl-3 hideOnReject">
						<label class="form-label" for="INT_DATE">Problem Solving:</label>
						<div class="rating-container">
							<div class="rating" id="rating">
								<span class="star ps_star" data-value="1">★</span>
								<span class="star ps_star" data-value="2">★</span>
								<span class="star ps_star" data-value="3">★</span>
								<span class="star ps_star" data-value="4">★</span>
								<span class="star ps_star" data-value="5">★</span>
							</div>
							<span class="ps_selectedRating" id="selectedRating">0</span>
							<div class="ps_emoji" id="emoji">🙂</div>
						</div>
					</div>

					<div class="col-xl-3 hideOnReject">
						<label class="form-label" for="INT_DATE">Confidence Skills:</label>
						<div class="rating-container">
							<div class="rating" id="rating">
								<span class="star con_star" data-value="1">★</span>
								<span class="star con_star" data-value="2">★</span>
								<span class="star con_star" data-value="3">★</span>
								<span class="star con_star" data-value="4">★</span>
								<span class="star con_star" data-value="5">★</span>
							</div>
							<span class="con_selectedRating" id="selectedRating">0</span>
							<div class="con_emoji" id="emoji">🙂</div>
						</div>
					</div>

					<div class="col-xl-3 hideOnReject">
						<label class="form-label" for="INT_DATE">Cultural Fit / Team Fit:</label>
						<div class="rating-container">
							<div class="rating" id="rating">
								<span class="star cf_star" data-value="1">★</span>
								<span class="star cf_star" data-value="2">★</span>
								<span class="star cf_star" data-value="3">★</span>
								<span class="star cf_star" data-value="4">★</span>
								<span class="star cf_star" data-value="5">★</span>
							</div>
							<span class="cf_selectedRating" id="selectedRating">0</span>
							<div class="cf_emoji" id="emoji">🙂</div>
						</div>
					</div>

					<div class="col-xl-6">
						<label class="form-label" for="OVERALL_REMARKS">Overall Remarks:</label>
						<textarea class="form-control" id="OVERALL_REMARKS" rows="1" type="text" autocomplete="off"></textarea>
					</div>

					<div class="col-xl-12 text-end">
						<button type="button" style="display:none" class="btn btn-success btn-print waves-effect waves-light float-end mx-1" id="BtnPrint">
							<i class="fa fa-print"></i> Print
						</button>
						<button class="btn btn-danger btn-delete" style="display:none"><i class="fa fa-trash"></i> Delete</button>
						@* <button class="btn btn-primary btn-save" id="generateCode">#Card No.</button> *@
						<button class="btn btn-primary btn-save" id="saveAttempt"><i class="fa fa-save"></i> Save</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-xl">
