@{
    var startDate = (Convert.ToDateTime(ViewBag.StartDate)).ToString("yyyy-MM-dd");
    var endDate = (Convert.ToDateTime(ViewBag.EndDate)).ToString("yyyy-MM-dd");
}

<div class="card">
    <div class="row">
        <div class="col-md-12">
            <div class="card-header">
                <button id="quicksearch" type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl"><i class="fa fa-search"></i> Quick Search</button>
                <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="resetall" style="display:none"><i class="fa fa-plus"></i> Add New</button>
            </div>
            <div class="card-body pt-1 Record">
                <div class="row">
                    <input id="TRAN_ID" hidden />
                    <input id="ADD_USER_ID" hidden />
                    <input id="ADD_DATE" hidden />
                    <input id="ADD_COMPUTER_NAME" hidden />
                    <input id="ADD_IP_ADDRESS" hidden />
                    <input id="ADD_POSTALCODE" hidden />
                    <input id="MENU_ID" hidden />
                    <input id="displayExpr_empcode" type="hidden" />
                    <input type="hidden" id="activestatushidden" />

                    @* <input type="hidden" id="department_hidden" />
                    <input id="unitcode_hidden" type="hidden" />
                    <input id="empcode_hidden" type="hidden" /> *@

                    <input type="hidden" id="displayExpr_department" />
                    <input id="displayExpr_unitcode" type="hidden" />
                    <div class="col-xl-3">
                        <label class="form-label" for="Code">Code :</label>
                        <input class="form-control" readonly id="Code" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="ASTATUS">Status :</label>
                        <div id="ASTATUS"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="V_DATE">Transaction Date:</label>
                        <input class="form-control" id="V_DATE" onchange="empr_helper.validateVDate()" type="date" max="@endDate" min="@startDate" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
                    </div>
                    <div class="col-xl-3 vHide">
                        <label class="form-label" for="VOUCHER_NO">Transaction #:</label>
                        <input class="form-control" id="VOUCHER_NO" type="text" readonly autocomplete="off">
                    </div>
                    <div class="col-xl-3 vHide">
                        <label class="form-label" for="REF">Reference No:</label>
                        <input class="form-control" id="REF" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="CLIENT_PO">Model# / PO#:</label>
                        <input class="form-control" id="CLIENT_PO" type="text" autocomplete="off">
                        @* <div id="CLIENT_PO"></div> *@
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="PARTY_CODE">Client Name:</label>
                        <div id="PARTY_CODE"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="DEP">Department:</label>
                        <div id="DEP"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="JOB_NO">Job #:</label>
                        <input class="form-control" id="JOB_NO" type="text" readonly autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="UNIT">Employee :</label>
                        <div id="EMP"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="SPARTY_CODE">Supplier :</label>
                        <div id="SPARTY_CODE"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="TERMS">Terms :</label>
                        <div id="TERMS"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="CURR_CODE">Currency</label>
                        <div id="CURR_CODE"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="CRATE">Curr.Rate:</label>
                        <input class="form-control" id="CRATE" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="ITEM_CODE">Item :</label>
                        <div id="ITEM_CODE"></div>
                    </div>

                    @* <div class="col-xl-3">
                        <label class="form-label" for="FABRIC">Fabric:</label>
                        <div id="FABRIC"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="GSM">GSM:</label>
                        <div id="GSM"></div>
                    </div> *@

                    <div class="col-xl-3">
                        <label class="form-label" for="GRADE">Brand :</label>
                        <div id="GRADE"></div>
                    </div>
                    <div class="col-xl-1">
                        <label class="form-label" for="QTY">Qty:</label>
                        <input class="form-control" id="QTY" type="number" step="0.01" min="0" onkeydown="return !['e', 'E', '+', '-'].includes(event.key)" autocomplete="off">
                    </div>
                    <div class="col-xl-2">
                        <label class="form-label" for="UNIT">Unit :</label>
                        <div id="UNIT"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="RATE">Rate:</label>
                        <input class="form-control" id="RATE"  readonly autocomplete="off">
                    </div>
                    <div class="col-xl-3 vHide">
                        <label class="form-label" for="AMT">Amount:</label>
                        <input class="form-control" id="AMT" type="number" step="0.01" min="0" onkeydown="return !['e', 'E', '+', '-'].includes(event.key)" autocomplete="off">
                    </div>
                    @* <div class="col-xl-3">
                        <label class="form-label" for="S_DATE">Ship Date:</label>
                        <input class="form-control" id="S_DATE" type="date" autocomplete="off">
                        value="@DateTime.Now.Date.ToString("yyyy-MM-dd")"
                    </div> *@
                    <div class="col-xl-3">
                        <label class="form-label" for="COMM_AMT">Commission Unit:</label>
                        <div id="COMM_AMT"></div>
                    </div>
                    <div class="col-xl-1">
                        <label class="form-label" for="COMM">Comm %:</label>
                        <input class="form-control" id="COMM" type="number" step="0.01" min="0" onkeydown="return !['e', 'E', '+', '-'].includes(event.key)" autocomplete="off">
                    </div>
                    <div class="col-xl-2">
                        <label class="form-label" for="COMM_VAL">Comm Amount:</label>
                        <input class="form-control" id="COMM_VAL" type="number" step="0.01" min="0" onkeydown="return !['e', 'E', '+', '-'].includes(event.key)" autocomplete="off" readonly>
                    </div>

                    @* <div class="col-xl-3">
                        <label class="form-label" for="DOC">PO:</label>
                        <input type="hidden" value="" id="hdnDOC" />
                        <div class="input-group">
                            <input type="file" name="DOC" id="DOC" class="form-control" onchange="empr_MerchantPurchaseOrder.UploadDoc()" placeholder="No File" accept=".pdf, .doc, .docx, .xls, .xlsx, image/*" />
                            <div class="input-group-append">
                                <a href="javascript:;" class="input-group-text" id="openDoc" onclick="empr_MerchantPurchaseOrder.OpenDoc()">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </div>
                        </div>
                    </div> *@

                    <div class="col-xl-3">
                        <label class="form-label" for="DOC">PO:</label>
                        <input type="hidden" value="" id="hdnDOC" />

                        <div class="input-group my-doc-input-group">
                            <input type="file" name="DOC" id="DOC" class="d-none" onchange="empr_MerchantPurchaseOrder.UploadDoc()" accept=".pdf, .doc, .docx, .xls, .xlsx, image/*" />

                            <input type="text" id="DOCName" class="form-control my-doc-text" placeholder="No File" readonly />

                            <button type="button" class="btn my-doc-browse" onclick="$('#DOC').click()">Browse</button>
                            <a href="javascript:;" class="my-doc-eye" id="openDoc" onclick="empr_MerchantPurchaseOrder.OpenDoc()"><i class="fa fa-eye my-eye-btn"></i></a>
                        </div>
                    </div>



                    <div class="col-xl-6">
                        <label class="form-label" for="REMARKS">Comment:</label>
                        <textarea class="form-control" id="REMARKS" rows="1" type="text" autocomplete="off"></textarea>
                    </div>
                    
                    <div class="col-xl-12 text-end">
                        <button type="button" style="display:none" class="btn btn-success btn-print waves-effect waves-light mx-1 mt-2" id="BtnPrint"><i class="fa fa-print"></i> Print</button>
                        <button class="btn btn-danger btn-delete mt-2" style="display:none"><i class="fa fa-trash"></i> Delete</button>
                        <button class="btn btn-primary btn-save mt-2" id="saveAttempt"><i class="fa fa-save"></i> Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Quick Search</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <div id="gridContainer"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>

    <div class="modal fade" id="SodaPickModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Pick Soda</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body customHighlightForModifiedCells">
                                <div class="table-responsive">
                                    <div id="SodaPickGridContainer"></div>
                                </div>
                                <div class="pt-3 text-end">
                                    <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnAddSodaToDelivery">
                                        <i class="fa fa-plus"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>

    <div class="modal fade bs-example-modal-xl" id="ShowReportModal" style="display:none" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Print Report</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-10">
                        <div class="row">
                            <div class="col-xl-4">
                                <label class="form-label" for="ReportType">ReportType:</label>
                                <div id="ReportType"></div>
                            </div>
                            <div class="col-xl-2 mt-20">
                                <button type="button" class="btn btn-primary mr-5" data-bs-toggle="modal" id="BtnGenerateReport">
                                    <i class="fa fa-file-arrow-down"></i> Get Report
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 mt-3">
                        <div class="card text-left" id="ModalBody"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section LinkScriptSection{
    <script type="text/javascript">
        var startDate = @startDate;
        var endDate = @endDate;
        var branchData = "";
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        var todayDate = '@DateTime.Now.Date.ToString("yyyy-MM-dd")';
        var dataClear = @Html.Raw(Json.Serialize(ViewBag.DATA_CLEAR));
        var Units = @Html.Raw(Json.Serialize(ViewBag.Units));
        var Departments = @Html.Raw(Json.Serialize(ViewBag.Departments));
        var Employee = @Html.Raw(Json.Serialize(ViewBag.Employee));
        var ClientPO = @Html.Raw(Json.Serialize(ViewBag.ClientPO));
        var Fabric = @Html.Raw(Json.Serialize(ViewBag.Fabric));
        var GSMData = @Html.Raw(Json.Serialize(ViewBag.GSMData));
    </script>
    <script type="text/javascript">
        $(function () {
            empr_MerchantPurchaseOrder.initEvents();
        });
    </script>
    <script src="~/js/customjs/empr_MerchantPurchaseOrder.js"></script>
}