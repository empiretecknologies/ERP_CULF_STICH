<style>
	#StockDetailContainer {
		width: 100%;
	}

	#StockReceiveContainer {
		width: 100%;
	}
</style>
<div class="card">
	<div class="card-header">
		<button type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal"
				data-bs-target=".bs-example-modal-xl" id="BtnQuickSearch">
			<i class="fa fa-search"></i> Quick Search
		</button>
		<button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnNew">
			<i class="fa fa-plus"></i> Add New
		</button>
	</div>
	<div class="card-body Record">
		<div class="row">
			<input id="ID" hidden />
			<input id="branchtohidden" hidden />
			<input id="branchfromhidden" hidden />
			<input id="PERIOD_ID" hidden />

			<input id="ITEM_NAME" hidden />
			<input id="REC_QTY" hidden />
			<input id="PICK_ID" hidden />

			<div class="col-xl-3">
				<label class="form-label" for="Code">Code:</label>
				<input class="form-control" id="Code" readonly type="text" autocomplete="off">
			</div>
			<div class="col-xl-3">
				<label class="form-label" for="ASTATUS">Status:</label>
				<div id="ASTATUS"></div>
			</div>
			<div class="col-xl-3">
				<label class="form-label" for="V_DATE">Transaction Date:</label>
				<input class="form-control" id="V_DATE" type="date" onkeydown="empr_helper.HandleTabFocus(event, '#REF')" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
			</div>
			<div class="col-xl-3">
				<label class="form-label" for="VOUCHER_NO">Transaction #:</label>
				<input class="form-control" id="VOUCHER_NO" type="text" readonly autocomplete="off">
			</div>
			<div class="col-xl-3">
				<label class="form-label" for="REF">Reference No:</label>
				<input class="form-control" id="REF" type="text" autocomplete="off">
			</div>
			<div class="col-xl-9">
				<label class="form-label" for="REMARKS">Comment</label>
				<textarea class="form-control" id="REMARKS" rows="1" type="text" autocomplete="off" onkeydown="empr_helper.MoveFocusToGrid(event, '#StockDetailContainer', 0, 'iteM_CODE')"></textarea>
			</div>

			<div class="col-xl-3">
				<label class="form-label" for="PICK_DATA">Pick Data:</label>
				<input class="form-control" id="PICK_DATA" type="text" autocomplete="off">
			</div>
			<div class="col-xl-3">
				<button type="button" class="btn btn-primary btn-save mr-5 mt-20" data-bs-toggle="modal" id="BtnSodaPick">
					<i class="fa fa-search"></i> Pick Data
				</button>
			</div>

			<div class="col-x-12 pt-2 text-end d-flex justify-content-end">

				<div id="ButtonsDiv" style="display: none">
					<button type="button" id="BtnPrint" class="btn btn-success btn-print waves-effect waves-light float-end">
						<i class="fa fa-print"></i> Print
					</button>
				</div>
			</div>
		</div>
		<div class="tab-content" id="pills-warningtabContent">
			<div class="tab-pane fade show active" id="pills-warninghome" role="tabpanel"
				 aria-labelledby="pills-warninghome-tab">
				<div class="row border-top mt-20">
					<div class="col-xl-5 mt-30">
						<div id="StockDetailContainer"></div>
					</div>

					<div class="col-xl-2 mt-30">
						<label class="form-label" for="PICK_ITEM">Pick Item:</label>
						<input class="form-control" id="PICK_ITEM" type="text" autocomplete="off">
						<label class="form-label" for="PICK_QTY">Pick Qty:</label>
						<input class="form-control" id="PICK_QTY" type="text" autocomplete="off">

						<button type="button" class="btn btn-primary btn-save mr-5 mt-20" data-bs-toggle="modal" style="width: 47%;" id="BtnEnter"> Enter </button>
						<button type="button" class="btn btn-primary mt-20" id="BtnTransfer" style="width: 47%;"><i class="fa fa-long-arrow-right"></i></button>

					</div>

					<div class="col-xl-5 mt-30">
						<div id="StockReceiveContainer"></div>
					</div>
				</div>
			</div>
		</div>


	</div>
	<div class="col-xl-12 text-end pt-5 pb-5 pr-10">
		<button class="btn btn-danger btn-delete" id="BtnDelete" style="display:none"><i class="fa fa-trash"></i> Delete</button>
		<button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
	</div>
	<div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
		 aria-hidden="true">
		<div class="modal-dialog modal-xl">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="myExtraLargeModalLabel">Quick Search</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="col-md-12">
						<div class="card text-left">
							<div class="card-body">
								<div class="table-responsive">
									<div id="gridContainer"></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div><!-- /.modal-content -->
		</div><!-- /.modal-dialog -->
	</div>
</div>


<input type="hidden" id="department_hidden" />
<input type="hidden" id="displayExpr_department" />
<input id="itemIdHidden" hidden />


<div class="modal fade bs-example-modal-xl" id="ShowReportModal" style="display:none" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="myExtraLargeModalLabel">Print Report</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="col-md-10">
					<div class="row">
						<div class="col-xl-4">
							<label class="form-label" for="ReportType">ReportType:</label>
							<div id="ReportType"></div>
						</div>
						<div class="col-xl-2 mt-20">
							<button type="button" class="btn btn-primary mr-5" data-bs-toggle="modal" id="BtnGenerateReport">
								<i class="fa fa-file-arrow-down"></i> Get Report
							</button>
						</div>
					</div>
				</div>
				<div class="col-md-12 mt-3">
					<div class="card text-left" id="ModalBody">
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section LinkScriptSection {
	<script type="text/javascript">
		var BranchTo = @Html.Raw(Json.Serialize(ViewBag.BranchTo));
		var ItemIds = @Html.Raw(Json.Serialize(ViewBag.ItemIds));
		var BranchFrom = @Html.Raw(Json.Serialize(ViewBag.BranchFrom));
		var PeriodTo = @Html.Raw(Json.Serialize(ViewBag.PeriodTo));
		var PeriodFrom = @Html.Raw(Json.Serialize(ViewBag.PeriodFrom));
		var Items = @Html.Raw(Json.Serialize(ViewBag.Items));
		var Units = @Html.Raw(Json.Serialize(ViewBag.Units));
		var Colors = @Html.Raw(Json.Serialize(ViewBag.Colors));
		var Sizes = @Html.Raw(Json.Serialize(ViewBag.Sizes));
		var Grades = @Html.Raw(Json.Serialize(ViewBag.Grades));
		var Type = @Html.Raw(Json.Serialize(ViewBag.Type));
		var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
		var CompCond = @Html.Raw(Json.Serialize(ViewBag.CompCond));
		var todayDate = '@DateTime.Now.Date.ToString("yyyy-MM-dd")';
		var Limit = @Html.Raw(Json.Serialize(ViewBag.Limit));
	</script>
	<script src="~/js/customjs/empr_StockReceive.js" asp-append-version="true"></script>
	<script type="text/javascript">
		$(function () {
			empr_StockReceive.InitEvents();
		});
	</script>
	@* <script src="https://unpkg.com/hotkeys-js/dist/hotkeys.min.js"></script> *@
}