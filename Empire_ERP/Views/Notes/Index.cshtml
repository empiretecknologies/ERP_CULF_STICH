<style>
    .custom-editor .ck-editor__editable {
        min-height: 400px; /* Set desired height */
    }
</style>
<div id="orders"></div>
<div class="card">
    <div class="row">
        <div class="col-md-12">
            <div class="card-header">
                <button id="quicksearch" type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl"><i class="fa fa-search"></i> Quick Search</button>
                <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="resetall" style="display:none"><i class="fa fa-plus"></i> Add New</button>
            </div>
            <div class="card-body pt-1 Record">
                <div class="row theme-form">
                    <input id="ID" hidden />
                    <input id="ADD_USER_ID" hidden />
                    <input id="ADD_DATE" hidden />
                    <input id="ADD_COMPUTER_NAME" hidden />
                    <input id="ADD_IP_ADDRESS" hidden />
                    <input id="ADD_POSTALCODE" hidden />
                    <input id="MENU_ID" hidden />
                    <div class="col-xl-4">
                        <label class="form-label" for="Code">Code :</label>
                        <input class="form-control" readonly id="Code" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-4">
                        <label class="form-label" for="DOC">Doc:</label>
                        <input type="hidden" value="" id="hdnDOC" />
                        <div class="input-group">
                            <input type="file" name="DOC" id="DOC" class="form-control" onchange="empr_Notes.UploadDoc()" accept=".pdf, .doc, .docx, .xls, .xlsx, image/*" />
                            <div class="input-group-append">
                                <a href="javascript:;" class="input-group-text" id="openDoc" onclick="empr_Notes.OpenDoc()">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <label class="form-label" for="V_DATE">Date:</label>
                        <input class="form-control" id="V_DATE" type="date" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
                    </div>
                    <div class="col-xl-12 pb-10">
                        <label class="form-label" for="GROUP_NAME">Notes:</label>
                        <div id="editor"></div>
                        @* <input class="form-control" id="GROUP_NAME" type="text" autocomplete="off"> *@
                    </div>
                    <div class="col-xl-12 text-end">
                        <button type="button" id="printButton" class="btn btn-success btn-print waves-effect waves-light" style="display:none">
                            <i class="fa fa-print"></i> Print
                        </button>
                        <button class="btn btn-danger btn-delete" style="display:none"><i class="fa fa-trash"></i> Delete</button>
                        <button class="btn btn-primary btn-save" id="saveAttempt"><i class="fa fa-save"></i> Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Quick Search</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <div id="gridContainer"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>
</div>

@section LinkScriptSection{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script type="text/javascript">
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
    </script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .build();

        connection.start();

        connection.on("ReceiveOrder", (orderJson) => {
            const order = JSON.parse(orderJson);
            console.log(order);
            $("#orders").append(`<div><strong>Voucher No:</strong> ${order.Master.VOUCHER_NO}</div>`);
        });
    </script>
    <script type="text/javascript">
        $(function () {
            empr_Notes.companyName = @Html.Raw(Json.Serialize(ViewBag.CompanyName));
            empr_Notes.companyAddress = @Html.Raw(Json.Serialize(ViewBag.CompanyAddress));
            empr_Notes.initEvents();
        });
    </script>
    <script src="~/js/customjs/empr_Notes.js"></script>
}