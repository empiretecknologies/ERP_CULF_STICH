@{
    var startDate = (Convert.ToDateTime(ViewBag.StartDate)).ToString("yyyy-MM-dd");
    var endDate = (Convert.ToDateTime(ViewBag.EndDate)).ToString("yyyy-MM-dd");
}
<style>
    .number-input {
        position: relative;
        display: inline-block;
    }

        .number-input input {
            width: 100%;
            text-align: center;
        }

        .number-input button {
            position: absolute;
            top: 75%;
            transform: translateY(-50%);
            border: none;
            border-radius: 2px;
            background: #ddd;
            width: 25px;
            height: 17px;
            cursor: pointer;
            font-size: 12px;
            transition: 0.2s;
        }

        .number-input .minus {
            left: 6px;
        }

        .number-input .plus {
            right: 6px;
        }

        .number-input button.plus.active {
            background: #055a87;
            color: white;
        }

        .number-input button.minus.active {
            background: #D22B2B;
            color: white;
        }
</style>
<div class="card">
    <div class="card-header">
        <button type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal"
                data-bs-target=".bs-example-modal-xl" id="BtnQuickSearch">
            <i class="fa fa-search"></i> Quick Search
        </button>
        <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnNew">
            <i class="fa fa-plus"></i> Add New
        </button>
    </div>
    <div class="card-body Record">
        <div class="row">
            <div class="col-xl-9">
                <div class="row">
                    <input id="ID" hidden />
                    <div class="col-xl-3">
                        <label class="form-label" for="Code">Code:</label>
                        <input class="form-control" id="Code" readonly type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="ASTATUS">Status:</label>
                        <div id="ASTATUS"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="SDATE">Soda Date:</label>
                        <input class="form-control" id="SDATE" type="date" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off" onkeydown="empr_helper.HandleTabFocus(event, '#V_DATE')">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="V_DATE">Transaction Date:</label>
                        <input class="form-control" id="V_DATE" onchange="empr_helper.validateVDate()" type="date" onkeydown="empr_helper.HandleTabFocusToSelectBox(event, '#SellerCode')" max="@endDate" min="@startDate" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
