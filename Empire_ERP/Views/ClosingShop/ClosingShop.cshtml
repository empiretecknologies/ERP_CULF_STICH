@model Empire_ERP.Core.Entities.ClosingViewModal

<style>
    .ls {
        letter-spacing: 0.7px !important;
    }

    .ls-wide {
        letter-spacing: 1.2px !important;
    }

    th {
        color:black;
        background-color:white;
    }

    tbody td {
        padding: 2px;
        padding-top: 8px;
        padding-bottom: 8px;
        font-size: 12px;
        text-align: center;
    }

   
</style>

<div style="max-width:72mm;
            font-size:15px;
            font-weight:300;
            font-family:'Tw Cen MT','Arial Narrow',sans-serif;
            letter-spacing:0.5px !important;
            ">


    <div style="text-align:center;">
        <img src="~/Client/Company/@Model.Clogo" style="width:150px;" /><br /><br />
        <b>@Model.BAddress</b><br />
        NTN: @Model.BNTN<br />
        Ph: @Model.BPhone
    </div>

    <br />
    @* /* ; */ *@
    <div style="border:1px solid #000;
                text-align:center;
                padding:3px;">
        <span style="font-size:18px;
                     font-weight:600;
                     letter-spacing:1px;">
            @Model.HeadingName
        </span>
    </div>
    <div style="font-size:15px !important; display: flex; flex-direction: column; width: 100%;letter-spacing:0.5px" class="mt-3 mb-0">
        <div style="display: flex;width: 100%;">
            <span style="font-weight: 500;">User : </span> &nbsp;&nbsp;&nbsp;<span> @Model.SalesmanName</span>
        </div>
        <div style="display:flex; justify-content:space-between;">
            <span><b>From:</b> @Model.FromDate</span>
            <span><b>To:</b> @Model.ToDate</span>
        </div>
     </div>

    



    @* <div style="font-size:13px;">
        <div style="display:flex; justify-content:space-between;">
            <span><b>From:</b> @Model.FromDate</span>
            <span><b>To:</b> @Model.ToDate</span>
        </div>
    </div> *@

    <hr style="border:0.5px solid #000;" />


    @foreach (var group in Model.GroupedItems)

    {
        <div style="border:1px solid #000;
                    text-align:center;
                    padding:3px; margin-bottom:5px;">
            <span style="font-size:18px;
                         font-weight:600;
                         letter-spacing:1px;">
                @group.PosType
            </span>
        </div>

        <table style="border-collapse: collapse;">
            <thead style="background-color: white !important; color :black !important;padding:3px;font-size:13px !important;font-weight:600;">
                <tr style="border-bottom:1px solid #000; ">
                    @if (group.PosType == "Products")
                    {
                        <th style="font-size:12px !important; margin: 3px; padding: 2px;text-align: center;border :0.5px solid black !important;">Description</th>
                        <th style="font-size:12px !important; margin: 3px; padding: 2px;text-align: center;border :0.5px solid black !important;">Qty</th>
                        <th style="font-size:12px !important; margin: 3px; padding: 2px;text-align: center;border :0.5px solid black !important;">Rate</th>
                        <th style="font-size:12px !important; margin: 3px; padding: 2px;text-align: center; border :0.5px solid black !important;">Disc</th>
                        <th style="font-size:12px !important; margin: 3px; padding: 2px;text-align: center;border :0.5px solid black !important;">Amt</th>
                    }
                    else
                    {
                        <th style=" font-size:13px !important; margin: 3px; padding: 2px;text-align: left;border :0.5px solid black !important;">Description</th>
                        <th style=" font-size:13px !important; margin: 3px; padding: 2px;text-align: center;border :0.5px solid black !important;">Amount</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in group.Items)
                {
                    if (group.PosType == "Products")
                    {

                        <tr style="line-height: 1; margin: 0; position: relative;">
                            <td style="margin: 3px; padding: 2px;text-align: left;border :0.5px solid black !important;">@item.Description</td>
                            <td style="margin: 3px; padding: 2px;text-align: center;border :0.5px solid black !important;">@item.Qty</td>
                            <td style="margin: 3px; padding: 2px;text-align: center;border :0.5px solid black !important;">@item.Rate</td>
                            <td style="margin: 3px; padding: 2px;text-align: center;margin: 3px; padding: 2px;border :0.5px solid black !important;">
                                @(item.Disc.HasValue && item.Disc.Value != 0 ? item.Disc.Value.ToString("N0") + "%" : "")</td>
                            <td style="margin: 3px; padding: 2px;text-align: center;border :0.5px solid black !important;"> @(item.Balance?.ToString("N0") ?? "0")</td>
                        </tr>
                    }
                    else
                    {
                        <tr style="font-size:14px !important;">
                            <td style="margin: 3px; padding: 2px; text-align: left;border :0.5px solid black !important;">@item.Description</td>
                            <td style="margin: 3px; padding: 2px ;text-align: center;border :0.5px solid black !important;">@(item.Balance?.ToString("N0") ?? "0")</td>
                        </tr>
                    }
                }


                <tr class="text-center" style="border-top:1px dotted #000; font-weight:600;">
                    <td>Total @group.PosType</td>
                    @if (group.PosType == "Products")
                    {
                        <td align="center">@group.Qty</td>
                        <td></td>
                        <td></td>
                        <td align="right">
                            @group.TotalBalance?.ToString("N0")
                        </td>
                    }
                    else
                    {
                        <td align="right">@group.TotalBalance?.ToString("N0")</td>
                    }
                </tr>
            </tbody>
        </table>


    }


    <div style="border:1px solid #000;
                padding:4px;
                margin-top:5px;">
        <span style="font-size:15px; font-weight:600; float:left;">
            CLOSING BALANCE
        </span>
        <span style="font-size:16px; font-weight:700; float:right;">
            @(
                        decimal.TryParse(Model.ClosingBalance, out var cb)
                        ? cb.ToString("N2")
                        : "0.00"
                        )

        </span>
        <div style="clear:both;"></div>
    </div>

  @*   <div style="font-size:13px;">
        <b>User:</b> @Model.SalesmanName
    </div> *@

    <hr style="border:0.5px solid #000;" />
    <div style="text-align:center; font-size:15px; margin-top:5px;width: auto;background:#000;clip-path: polygon(20px 0%, 100% 0%, 100% 100%, 0% 100%);">
    <div class="website-bar"
         style="
         background:#000;
    
         color:#fff;
         padding:6px 12px;
         display:inline-block;
         font-weight:1000;
         letter-spacing:0.9px !important;
         max-width:100% !important;">
        @Model.FWebsite
    </div>
    </div>

</div>
