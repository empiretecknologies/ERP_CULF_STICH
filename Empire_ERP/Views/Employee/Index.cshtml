@* camera modal *@
<div class="modal fade" id="uploadImageModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title">Upload / Capture Image</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
						onclick="empr_Employee.stopCamera()"></button>
			</div>
			<div class="modal-body text-center image-box-modal">

				<!-- Croppie container (hidden initially) -->
				<div id="croppieContainer" style="display:none;"></div>
				<video id="cameraPreview" autoplay style="width:100%; height:100%; object-fit:cover;"></video>

				<img id="empProfileImg" src="" alt="Employee Image" />


			</div>
			<div class="modal-footer">
				<input type="file" id="empImgUpload" accept="image/*" style="display:none;" />
				<button type="button" id="btnPickImage" class="btn btn-primary btn-sm" style="display:none;">Pick Image</button>
				<button type="button" id="btnTakeCapture" class="btn btn-danger btn-sm" style="display:none;">Capture</button>
				<button type="button" id="btnTransImg" class="btn btn-danger btn-sm" style="display:none;">Upload Image</button>
				<button type="button" id="btnClearImage" class="btn btn-primary btn-sm" style="display:none;">Clear</button>
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" onclick="empr_Employee.stopCamera()">Close</button>
			</div>
		</div>
	</div>
</div>

