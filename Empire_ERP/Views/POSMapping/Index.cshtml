							<label class="form-label" for="SRB_SEND">SRB Send</label>
							<input class="form-check-input" type="checkbox" id="srbcheck">
						</div>
						@* <div class="form-check" style="margin-top: 15px;margin-left: 30px;">
							<label class="form-label" for="RATE">Rate</label>
							<input class="form-check-input" type="checkbox" id="RATE">
						</div> *@
						<div class="form-check" style="margin-top: 15px;margin-left: 30px;">
							<label class="form-label" for="QR Code">QR Code</label>
							<input class="form-check-input" type="checkbox" id="QR_CODE">
						</div>
						<div class="form-check" style="margin-top: 15px;margin-left: 30px;">
							<label class="form-label" for="P_WINDOW ">Print Window : </label>
							<input class="form-check-input" type="checkbox" id="P_WINDOW">
						</div>
					</div>
					<div class="col-xl-3 d-flex">
						<div class="form-check" style="margin-top: 15px;margin-left: 5px;">
							<label class="form-label" for="PAY_MODAL">Pay Modal</label>
							<input class="form-check-input" type="checkbox" id="PAY_MODAL">
						</div>
						@* <div class="form-check" style="margin-top: 15px;margin-left: 30px;">
							<label class="form-label" for="RATE">Rate</label>
							<input class="form-check-input" type="checkbox" id="RATE">
						</div> *@
						<div class="form-check" style="margin-top: 15px;margin-left: 30px;">
							<label class="form-label" for="PRE_MODAL">Pre Print</label>
							<input class="form-check-input" type="checkbox" id="PRE_MODAL">
						</div>
						<div class="form-check" style="margin-top: 15px;margin-left: 30px;">
							<label class="form-label" for="DUP_MODAL ">Dup Window</label>
							<input class="form-check-input" type="checkbox" id="DUP_MODAL">
						</div>
					</div>
				
					<div class="col-xl-3">
						<label class="form-label" for="PAY_COPY"> Pay Copies :</label>
						<input type="number" id="PAY_COPY" name="PAY_COPY" class="form-control" autocomplete="off">
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="PRE_COPY"> Pre Copies :</label>
						<input type="number" id="PRE_COPY" name="PRE_COPY" class="form-control" autocomplete="off">
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="DUP_COPY"> Dup Copies :</label>
						<input type="number" id="DUP_COPY" name="DUP_COPY" class="form-control" autocomplete="off">
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="P_PRINTER"> Pay Printer :</label>
						<input type="text" id="P_PRINTER" name="P_PRINTER" class="form-control" autocomplete="off">
					</div>
					@* ///herer *@
					<div class="col-xl-3">
						<label class="form-label" for="LOC_SNAME">Location Short Name :</label>
