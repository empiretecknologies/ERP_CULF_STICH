					</div>
					<div class="col-xl-3">
						<label class="form-label" for="POS_USER">SRB User :</label>
						<input class="form-control" id="POS_USER" type="text" autocomplete="off">
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="POS_PASS">SRB Password :</label>
						<input class="form-control" id="POS_PASS" type="text" autocomplete="off">
