            </div>

            <div class="col-xl-3">
                <label class="form-label" for="RINV_DATE">R.Inv Date:</label>
                <input class="form-control" id="RINV_DATE" type="date" value="2026-04-11" autocomplete="off" max="9999-12-31">
            </div> *@

            <div class="col-xl-3">
                <label class="form-label" for="DOC">Doc :</label>
                <input type="hidden" value="" id="hdnDOC">

                <div class="input-group my-doc-input-group">
                    <input type="file" name="DOC" id="DOC" class="d-none" onchange=" empr_PurchaseOrder.UploadDoc()" accept=".pdf, .doc, .docx, .xls, .xlsx, image/*">

                    <input type="text" id="DOCName" class="form-control my-doc-text" placeholder="No File" readonly="">

                    <button type="button" class="btn my-doc-browse" onclick="$('#DOC').click()">Browse</button>
                    <a href="javascript:;" class="my-doc-eye" id="openDoc" onclick=" empr_PurchaseOrder.OpenDoc()"><i class="fa fa-eye my-eye-btn"></i></a>
                </div>
            </div>

            <div class="col-xl-6">
                <label class="form-label" for="REMARKS">Comment:</label>
                <textarea class="form-control" id="REMARKS" rows="1" type="text" autocomplete="off"></textarea>
            </div>


            <div class="col-x-12 pt-1 text-end">
                <button type="button" class="btn btn-primary btn-save mr-5" id="BtnSodaPick">
                    <i class="fa fa-search"></i> Pick Data
                </button>
                <button type="button" id="BtnPrint" class="btn btn-success btn-print waves-effect waves-light float-end">
                    <i class="fa fa-print"></i> Print
                </button>
            </div>
        </div>
