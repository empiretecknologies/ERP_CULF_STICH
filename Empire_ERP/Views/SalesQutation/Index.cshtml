                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label" for="V_DATE">Date</label>
                        <input class="form-control" id="V_DATE" type="date" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
                    </div>
                    <div class="col-12 mb-2">
                        <label class="form-label" for="PARTY_CODE">Party</label>
                        <div id="PARTY_CODE"></div>
                        <button type="button" class="btn btn-light mt-2" id="BtnUploadFile">
                            <i class="fa fa-upload"></i> Upload File
                        </button>
                        <div class="sq-excel-upload" id="sqExcelUpload">
                            <div class="sq-excel-label">Excel Upload</div>
                            <div class="sq-excel-drop" id="sqExcelDrop">
                                <i class="fa fa-file-excel"></i>
                                <p class="sq-excel-drop-title">Select or drop an Excel file</p>
                                <p class="sq-excel-drop-hint">.xlsx with ItemCode, Items, GroupName, SaleRate, Doc, CurrentStock and Branch Qty columns</p>
                                <p class="sq-excel-file-name" id="sqExcelFileName"></p>
                                <div class="sq-excel-actions">
                                    <button type="button" class="btn btn-light btn-sm" id="BtnSelectExcel">
                                        <i class="fa fa-upload"></i> Choose File
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" id="BtnExcelClear" style="display:none">
                                        Clear
                                    </button>
                                </div>
                                <input type="file" id="sqExcelFile" accept=".xlsx" hidden>
                            </div>
                            <div class="sq-excel-status" id="sqExcelStatus"></div>
                            <div class="sq-excel-review" id="sqExcelReview" style="display:none"></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="REMARKS">Remarks</label>
                        <textarea class="form-control" id="REMARKS" rows="3" autocomplete="off"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="BtnModalSave">Next</button>
                <button type="button" class="btn btn-success" id="BtnExcelComplete" style="display:none">
                    <i class="fa fa-check"></i> Complete
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ViewCartModal" tabindex="-1" role="dialog" aria-labelledby="ViewCartModalLabel" aria-hidden="true">
