@model Empire_ERP.Core.Entities.SlipViewModel

<div style="width: auto;font-size:0.9rem !important; font-weight: 400; font-family: 'Poppins', sans-serif;">
   
    <div style="text-align: center;">
        <img src="~/Client/Company/@Model.Clogo" alt="Company Logo" style="width: 150px;"><br />
        <b>@Model.BName</b><br />
        <b>@Model.BAddress</b><br />
        <b>@Model.BPhone</b>
    </div>

    <div style="font-size:0.9rem !important; font-weight: 400; display: flex; flex-direction: column; width: 100%;">
        <div style="display: flex;width: 100%;">
            <b>REF #: </b> <span>@Model.ReferenceNumber</span>
        </div>

        <div style="display: flex; width: 100%;">
            <b>DATE: </b> <span>@Model.Date @Model.Time</span>
        </div>

        <div style="display: flex; width: 100%;">
            <b>CUSTOMER: </b> <span>@Model.CustomerName</span>
        </div>

        <div style="display: flex; width: 100%;">
            <b>CONTACT #: </b> <span>@Model.ContactNumber</span>
        </div>

        <div style="display: flex; width: 100%;">
            <b>SALESMAN: </b> <span>@Model.SalesmanName</span>
        </div>
    </div>

    <div style="width: auto; background-color: #055a87 !important;color: white; text-align: center;">
        <span style="font-weight: bold; font-size: 25px;">SALES RECEIPT</span>
    </div>

    <br />

    <div>

    <table class="slip" style="font-size:0.9rem !important; font-weight: 400;border-collapse: collapse;">
        <thead style="background-color: white !important; color :black !important;">
            <tr>
                <th style="text-align: center;border :0.5px dotted !important;">Description</th>
                <th style="text-align: center;border :0.5px dotted !important;">Qty</th>
                <th style="text-align: center;border :0.5px dotted !important;">Price</th>
                <th style="text-align: center;border :0.5px dotted !important;">Disc %</th>
                <th style="text-align: center;border :0.5px dotted !important;">Amount</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null)
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td colspan="5" style="text-align: left; white-space: nowrap;">@item.Description</td>
                    </tr>
                    <tr>
                        <td style="text-align: center;"></td>
                        <td style="text-align: center;">@item.Quantity</td>
                        <td style="text-align: center;">@item.Price</td>
                        <td style="text-align: center;">@item.Discount</td>
                        <td style="text-align: right;">@item.Amount</td>
                    </tr>
                }
            }

        </tbody>
    </table>

    </div>

    <hr style="border: 1px solid black;">

    <div style="font-size:0.9rem !important; font-weight: 400; width: 100%; text-align: left;">
        <span style="float: left;">BILL DISC: </span><span style="text-align:center;">@Model.DiscountPercentage %</span> <span style="float: right;">(@Model.RoundingDiscount)</span><br />
        <span style="float: left;">TAX : </span><span style="text-align:center;">@Model.TAX %</span> <span style="float: right;">@Model.TotalTax</span><br />
        <div style="width: auto; background-color: #055a87; color:white;">
            <span style="float: left; font-weight: bold;">INVOICE VALUE: </span> <span style="float: right;"><b>@Model.TotalAmountFormatted</b></span><br />
        </div>
    </div>
    <br />
    <div style="width: auto;border: 0.5px dotted !important;text-align: center;">
        <span style="font-weight: bold; font-size: 25px;">PAYMENTS</span>
    </div>
    @if(Model.Bank != 0 && Model.Party != 0)
    {
        <div style="font-size:0.9rem !important; font-weight: 400; width: 100%; text-align: left;">
            <b style="float: left; font-weight: bold;">CASH: </b> <span style="float: right;"><b>@Model.CashFormatted</b></span><br />
            <b style="float: left; font-weight: bold;">BANK: </b> <span style="float: right;"><b>@Model.BankFormatted</b></span><br />
            <b style="float: left; font-weight: bold;">PARTY: </b> <span style="float: right;"><b>@Model.PartyFormatted</b></span><br />
        </div>
    }
    else if(Model.Bank != 0)
    {
        <div style="font-size:0.9rem !important; font-weight: 400; width: 100%; text-align: left;">
            <b style="float: left; font-weight: bold;">BANK: </b> <span style="float: right;"><b>@Model.BankFormatted</b></span><br />
        </div>
    }
    else if(Model.Party != 0)
    {
        <div style="font-size:0.9rem !important; font-weight: 400; width: 100%; text-align: left;">
            <b style="float: left; font-weight: bold;">PARTY: </b> <span style="float: right;"><b>@Model.PartyFormatted</b></span><br />
        </div>
    }
    else
    {
        <div style="font-size:0.9rem !important; font-weight: 400; width: 100%; text-align: left;">
            <span style="float: left; font-weight: bold;">CASH: </span> <span style="float: right;"><b>@Model.CashFormatted</b></span><br />
            <span style="float: left;">CASH BACK: </span><span style="float: right;">@Model.CashBack</span><br />
        </div>
    }

    <hr style="border: 1px solid black;">

    @* <div style="text-align: center;font-size:0.9rem !important; font-weight: 400;">
        <h1>SHOP ONLINE AT</h1>
        <p><b>facebook.com/empiretechnologies </b><i class="fab fa-facebook"></i></p>
    </div>

    <hr style="border: dotted;"> *@

    <div style="font-size:0.9rem !important; font-weight: 400;">
        <div style="width: auto;text-align: center;">
            <span style="font-weight: bold; font-size: 20px;">TERMS & CONDITIONS</span>
        </div>
        <p>
           @*  1: No Cash Refund.<br />
            2: Original Sales Invoice & Product Barcode both are compulsory for exchange.<br />
            3: Goods to be exchanged within 7 days from the date of purchase. *@
            @Model.MENUTERMS
        </p>
    </div>
    <hr style="border: 0.5px dotted;">
    <div style="text-align: center;font-size:0.9rem !important; font-weight: 400;">
        <p>
            Softwear Designed By: @Model.FName <br />
            @Model.FTEL <br />
            @Model.FWebsite
        </p>
    </div>

</div>



