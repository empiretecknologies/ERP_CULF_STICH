@section LinkScriptSection{
    <script type="text/javascript">
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        var BarcodeVisible = @Html.Raw(Json.Serialize(ViewBag.Barcode));
        var Brand = @Html.Raw(Json.Serialize(ViewBag.Brand));
        var Style = @Html.Raw(Json.Serialize(ViewBag.Style));
        var Season = @Html.Raw(Json.Serialize(ViewBag.Season));
        var Fabric = @Html.Raw(Json.Serialize(ViewBag.Fabric));
        var dataClear = @Html.Raw(Json.Serialize(ViewBag.DATA_CLEAR));
        var Colors = @Html.Raw(Json.Serialize(ViewBag.Colors));
        var Sizes = @Html.Raw(Json.Serialize(ViewBag.Sizes));

    </script>
    <script src="~/js/customjs/empr_Helper.js" asp-append-version="true"></script>
    <script src="~/js/customjs/empr_ItemMaster.js" asp-append-version="true"></script>
    <script src="~/js/customjs/empr_Cropper.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/croppie/2.6.5/croppie.min.js" integrity="sha512-Gs+PsXsGkmr+15rqObPJbenQ2wB3qYvTHuJO6YJzPe/dTLvhy0fmae2BcnaozxDo5iaF8emzmCZWbQ1XXiX2Ig==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script type="text/javascript">
        $(".TabsDiv").tabs();
        empr_ItemMaster.initEvents();
    </script>
}