<div class="modal fade" id="uploadImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg">

            <!-- Header -->
            <div class="modal-header bg-primary text-white rounded-top py-3 px-4">
                <h5 class="modal-title fw-semibold">📸 Take Your Picture</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"
                        onclick="empr_Employee.stopCamera()"></button>
            </div>

            
            <div class="modal-body text-center p-4 image-box-modal">
                <div id="croppieContainer" class="mb-3" style="display:none;"></div>

                <video id="cameraPreview" autoplay muted playsinline class=" mb-3" style="object-fit:cover;;"></video>

                <img id="empProfileImg" src="" alt="Employee Image" class="img-fluid rounded-circle shadow-sm" style="max-width:150px;" />
            </div>

           
            <div class="modal-footer d-flex flex-wrap justify-content-center gap-2 px-4 pb-4">
                <input type="file" id="empImgUpload" accept="image/*" hidden />

                <button type="button" id="btnPickImage" class="btn btn-primary btn-sm">
                    <i class="bi bi-folder2-open"></i> Pick Image
                </button>
                <button type="button" id="btnTakeCapture" class="btn btn-danger btn-sm">
                    <i class="bi bi-camera"></i> Capture
                </button>
                <button type="button" id="btnTransImg" class="btn btn-success btn-sm">
                    <i class="bi bi-cloud-upload"></i> Upload Image
                </button>
                <button type="button" id="btnClearImage" class="btn btn-warning btn-sm">
                    <i class="bi bi-trash"></i> Clear
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" onclick="empr_Employee.stopCamera()">
                    <i class="bi bi-x-circle"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>



 
