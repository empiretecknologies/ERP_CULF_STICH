                            <div id="EDUCTION"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="VEH_NUMBER">Vehicle No. :</label>
                            <input class="form-control" id="VEH_NUMBER" type="text" autocomplete="off">
                        </div>
