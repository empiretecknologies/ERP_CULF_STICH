@{
	ViewData["Title"] = "Home Page";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
	<div class="col-lg-3 col-md-6">
		<div class="bx-kpi">
			<div class="kpi-inner">
				<h4>Sales</h4>
				<h2>0.00</h2>
				<h6 class="color-green"><i class="fa-solid fa-arrow-up"></i> 0.00%</h6>
			</div>
			<div class="kpi-inner">
				<span class="kpiicn">
					<i class="fa-solid fa-shop"></i>
				</span>
			</div>
		</div>
	</div>
	<div class="col-lg-3 col-md-6">
		<div class="bx-kpi">
			<div class="kpi-inner">
				<h4>Purchase</h4>
				<h2>0.00</h2>
				<h6 class="color-red"><i class="fa-solid fa-arrow-down"></i> 0.00%</h6>
			</div>
			<div class="kpi-inner">
				<span class="kpiicn">
					<i class="fa-solid fa-money-bill"></i>
				</span>
			</div>
		</div>
	</div>
	<div class="col-lg-3 col-md-6">
		<div class="bx-kpi">
			<div class="kpi-inner">
				<h4>Return</h4>
				<h2>0.00</h2>
				<h6 class="color-green"><i class="fa-solid fa-arrow-up"></i> 0.00%</h6>
			</div>
			<div class="kpi-inner">
				<span class="kpiicn">
					<i class="fa-solid fa-rotate-left"></i>
				</span>
			</div>
		</div>
	</div>
	<div class="col-lg-3 col-md-6">
		<div class="bx-kpi">
			<div class="kpi-inner">
				<h4>Marketing</h4>
				<h2>0.00</h2>
				<h6 class="color-red"><i class="fa-solid fa-arrow-down"></i> 0.00%</h6>
			</div>
			<div class="kpi-inner">
				<span class="kpiicn">
					<i class="fa-solid fa-chart-line"></i>
				</span>
			</div>
		</div>
	</div>
</div>
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Bubble Chart</h3>
			</div>
			<div class="card-body">
				<div class="dx-viewport demo-container">
					<div id="bubble" class="w-100"></div>
				</div>
			</div>
		</div>
	</div>
	<div class="col-lg-6">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Area Chart</h3>
			</div>
			<div class="card-body">
				<div class="dx-viewport demo-container">
					<div id="area" class="w-100"></div>
				</div>
			</div>
		</div>
	</div>
	<div class="col-lg-6">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Bar Chart</h3>
			</div>
			<div class="card-body">
				<div class="dx-viewport demo-container">
					<div id="bar" class="w-100"></div>
				</div>
			</div>
		</div>
	</div>
	<div class="col-lg-6">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Pie Chart</h3>
			</div>
			<div class="card-body">
				<div class="dx-viewport demo-container">
					<div id="pie" class="w-100"></div>
				</div>
			</div>
		</div>
	</div>
	<div class="col-lg-6">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Radar Chart</h3>
			</div>
			<div class="card-body">
				<div class="dx-viewport demo-container">
					<div id="radarchart" class="w-100"></div>
				</div>
			</div>
		</div>
	</div>
	<div class="col-lg-6">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Doughnut Chart</h3>
			</div>
			<div class="card-body">
				<div class="dx-viewport demo-container">
					<div id="pie2" class="w-100"></div>
				</div>
			</div>
		</div>
	</div>
</div>
