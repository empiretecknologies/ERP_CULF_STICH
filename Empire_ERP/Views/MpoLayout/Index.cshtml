<div class="modal fade bs-example-modal-xl" id="ShowReportModal" style="display:none" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myExtraLargeModalLabel">Print Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-md-10">
                    <div class="row">
                        <div class="col-xl-4">
                            <label class="form-label" for="ReportType">ReportType:</label>
                            <div id="ReportType"></div>
                        </div>
                        <div class="col-xl-2 mt-20">
                            <button type="button" class="btn btn-primary mr-5" data-bs-toggle="modal" id="BtnGenerateReport">
                                <i class="fa fa-file-arrow-down"></i> Get Report
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mt-3">
                    <div class="card text-left" id="ModalBody"></div>
                </div>
            </div>
        </div>
    </div>
</div>


@section LinkScriptSection{
    <script type="text/javascript">
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        var Items = @Html.Raw(Json.Serialize(ViewBag.Items));
        var FinishItems = @Html.Raw(Json.Serialize(ViewBag.FinishItems));
        var Units = @Html.Raw(Json.Serialize(ViewBag.Units));
        var Colors = @Html.Raw(Json.Serialize(ViewBag.Colors));
        var Sizes = @Html.Raw(Json.Serialize(ViewBag.Sizes));
        var Ports = @Html.Raw(Json.Serialize(ViewBag.Ports));
        var Items = @Html.Raw(Json.Serialize(ViewBag.Items));
        var SEntity = @Html.Raw(Json.Serialize(ViewBag.SEntity));
        var DistributionChannel = @Html.Raw(Json.Serialize(ViewBag.DistributionChannel));
        var Grade = @Html.Raw(Json.Serialize(ViewBag.Grade));
        var Season = @Html.Raw(Json.Serialize(ViewBag.Season));
        var CompCond = @Html.Raw(Json.Serialize(ViewBag.CompCond));
        // var Supplier = @Html.Raw(Json.Serialize(ViewBag.Supplier));
        var ClientPO = @Html.Raw(Json.Serialize(ViewBag.ClientPO));
        var POJobs = @Html.Raw(Json.Serialize(ViewBag.POJobs));
        // var Fabric = @Html.Raw(Json.Serialize(ViewBag.Fabric));
        // var GSMData = @Html.Raw(Json.Serialize(ViewBag.GSMData));
    </script>
