                      document.addEventListener('DOMContentLoaded', function () {
                const sidebar = document.querySelector('.main_wrap');
                $.get("/FavoriteMenu/GetFavorites", function (data) {
                    if (data.data.length > 0) {
                        const isOpen = data.data[0].iS_SIDEBAR_OPEN;
                        if (isOpen) {
                            sidebar.classList.remove('collapse_sidebar');
                            sidebar.classList.remove('collapsed');
                        }
                    } else {
                        sidebar.classList.add('collapse_sidebar');
                    }
                });
            });

                    document.getElementById('myTab')?.addEventListener(
                'keydown',
                blockArrowKeys,
                true
            );

            document.querySelectorAll('.my-tabsss').forEach(function (el) {
                el.addEventListener(
                    'keydown',
                    blockArrowKeys,
                    true
                );
            });
            function blockArrowKeys(e) {
                if (
                    e.key === 'ArrowLeft' ||
                    e.key === 'ArrowRight' ||
                    e.key === 'ArrowUp' ||
                    e.key === 'ArrowDown'
                ) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    return false;
                }
            }

            $(document).ready(function () {
                  setTimeout(function () {
                  $('input[type="date"]').each(function () {
                      $(this).attr('max', '9999-12-31');
                      $(this).val();
                  });
                  }, 100);
                });
