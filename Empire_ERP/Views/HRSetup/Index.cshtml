    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade" id="pills-warningsetup1" role="tabpanel" aria-labelledby="pills-warningsetup1-tab">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-3">
                            <label class="form-label" for="Code">Code :</label>
                            <input class="form-control" id="Code" readonly type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="ASTATUS">Status:</label>
                            <div id="ASTATUS"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="MACHINE_CODE">Machine ID :</label>
                            <input class="form-control" id="MACHINE_CODE" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="EMP_ID">HRSetup ID :</label>
                            <input class="form-control" id="EMP_ID" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="ENAME">Name :</label>
                            <input class="form-control" id="ENAME" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="FATHER_NAME">Father Name :</label>
                            <input class="form-control" id="FATHER_NAME" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="EMAIL">Email :</label>
                            <input class="form-control" id="EMAIL" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="CELL_NO">Cell :</label>
                            <input class="form-control ContactNo" id="CELL_NO" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="GENDER">Gender:</label>
                            <div id="GENDER"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="REG">Religion:</label>
                            <div id="REG"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="DEP_ID">Department:</label>
                            <div id="DEP_ID"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="DESIG">Designation:</label>
                            <div id="DESIG"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="EMP_TYPE">Type:</label>
                            <div id="EMP_TYPE"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="SHIFT_T">Timings :</label>
                            <input type="hidden" id="SHIFT_hidden" />
                            <input type="hidden" id="displayExprShift" />
                            <div id="SHIFT_T"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="BCODE">Branch :</label>
                            <div id="BCODE"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="PAY_MODE">Payment Mode :</label>
                            <div id="PAY_MODE"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="JOIN_DATE">Joining Date :</label>
                            <input class="form-control" id="JOIN_DATE" type="date" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="PARM_DATE">Permanent Date :</label>
                            <input class="form-control" id="PARM_DATE" type="date" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="CHILD">Childrens:</label>
                            <input class="form-control" id="CHILD" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="FAMILY_NUM">Family No:</label>
                            <input class="form-control" id="FAMILY_NUM" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="CNIC">CNIC No:</label>
                            <input class="form-control cnic" id="CNIC" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="CNIC_IDATE">CNIC Issue Date:</label>
                            <input class="form-control" id="CNIC_IDATE" type="date" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="CNIC_EDATE">CNIC Expiry Date:</label>
                            <input class="form-control" id="CNIC_EDATE" type="date" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="BANK_NAME">Bank :</label>
                            <input class="form-control" id="BANK_NAME" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="BANK_ACC">Account No. :</label>
                            <input class="form-control" id="BANK_ACC" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="NTN_NO">NTN No. :</label>
                            <input class="form-control" id="NTN_NO" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="FILE_NO">File No. :</label>
                            <input class="form-control" id="FILE_NO" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="NATION">Nationality :</label>
                            <input class="form-control" id="NATION" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="POB">POB :</label>
                            <input class="form-control" id="POB" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="DOB">DOB :</label>
                            <input class="form-control" id="DOB" type="date" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="MSTATUS">Marital Status :</label>
                            <div id="MSTATUS"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="RSTATUS">Roaster Status :</label>
                            <div id="RSTATUS"></div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="THUMB">Thumb :</label>
                            <input type="hidden" value="" id="hdnTHUMB" />
                            <div class="input-group">
                                <input type="file" name="THUMB" id="THUMB" class="form-control" onchange="empr_HRSetup.UploadThumb()" accept=".pdf, .doc, .docx, .xls, .xlsx, image/*" />
                                <div class="input-group-append">
                                    <a href="javascript:;" class="input-group-text" id="OpenThumb" onclick="empr_HRSetup.OpenThumb()">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="SIGNA">Signature :</label>
                            <input type="hidden" value="" id="hdnSIGNA" />
                            <div class="input-group">
                                <input type="file" name="SIGNA" id="SIGNA" class="form-control" onchange="empr_HRSetup.UploadSign()" accept=".pdf, .doc, .docx, .xls, .xlsx, image/*" />
                                <div class="input-group-append">
                                    <a href="javascript:;" class="input-group-text" id="OpenThumb" onclick="empr_HRSetup.OpenSign()">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="EMP_IMG">Image :</label>
                            <input type="hidden" id="EMP_IMG" name="EMP_IMG" />
                            <div class="input-group">
                                <input class="form-control" id="Image" type="file" accept="image/*" autocomplete="off">
                                <div class="input-group-append">
                                    <a href="javascript:;" class="input-group-text" id="OpenImage" onclick="empr_HRSetup.OpenImage()">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <label class="form-label" for="EMP_ADD">Address :</label>
                            <textarea class="form-control" id="EMP_ADD" rows="1" type="text" autocomplete="off"></textarea>
                        </div>
                        <div class="col-xl-2">
                            <label class="form-label" for="SALARY_HOLD">Salary Hold :</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" id="SALARY_HOLD" type="checkbox" checked>
                            </div>
                        </div>
                        <div class="col-xl-2">
                            <label class="form-label" for="MSTAFF">MSTAFF :</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" id="MSTAFF" type="checkbox" checked>
                            </div>
                        </div>
                        <div class="col-xl-2">
                            <label class="form-label" for="OT">OT :</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" id="OT" type="checkbox" checked>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="pills-warningsetup2" role="tabpanel" aria-labelledby="pills-warningsetup2-tab">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-3">
