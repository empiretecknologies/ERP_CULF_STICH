						<div class="input-group">
							<input class="form-control" id="WaiterImage" type="file" accept="image/*" autocomplete="off">
							<div class="input-group-append">
								<a href="javascript:;" class="input-group-text" id="OpenWaiterImage" onclick="empr_POSMapping.OpenWaiterImage()">
									<i class="fa fa-eye"></i>
								</a>
							</div>
						</div>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="Table_IMG">Table Image :</label>
						<input type="hidden" id="Table_IMG" name="Table_IMG" />
						<div class="input-group">
							<input class="form-control" id="TableImage" type="file" accept="image/*" autocomplete="off">
							<div class="input-group-append">
								<a href="javascript:;" class="input-group-text" id="OpenTableImage" onclick="eempr_POSMapping.OpenTableImage()">
									<i class="fa fa-eye"></i>
								</a>
							</div>
						</div>
					</div>
					<div class="col-xl-9 d-flex" style="gap: 44px;margin-top: 23px;">
						<div class="form-check">
							<label class="form-label" for="CASH_TAB">Advance</label>
							<input class="form-check-input" type="checkbox" id="advancecheck">
						</div>
						<div class="form-check">
							<label class="form-label" for="CASH_TAB">Cash Tab</label>
							<input class="form-check-input" type="checkbox" id="cashcheck">
						</div>
						<div class="form-check">
							<label class="form-label" for="CASH_TAB">Bank Tab</label>
							<input class="form-check-input" type="checkbox" id="bankcheck">
						</div>
						<div class="form-check">
							<label class="form-label" for="CASH_TAB">Party Tab</label>
							<input class="form-check-input" type="checkbox" id="partycheck">
						</div>
						<div class="form-check">
							<label class="form-label" for="CASH_TAB">Split Tab</label>
							<input class="form-check-input" type="checkbox" id="splitcheck">
						</div>
						<div class="form-check">
							<label class="form-label" for="CASH_TAB">Advance Btn</label>
							<input class="form-check-input" type="checkbox" id="advancebtn">
						</div>
						<div class="form-check">
							<label class="form-label" for="CASH_TAB">Kot Btn</label>
							<input class="form-check-input" type="checkbox" id="kotbtn">
						</div>
						<div class="form-check">
							<label class="form-label" for="CASH_TAB">Salesman Required</label>
							<input class="form-check-input" type="checkbox" id="salesmanReq">
						</div>
