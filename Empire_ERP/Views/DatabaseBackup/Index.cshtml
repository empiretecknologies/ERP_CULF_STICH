<div class="card">
    <div class="row">
        <div class="col-md-12">
            <div class="card text-left">
                <div class="card-header">
                    <button type="button" id="BtnGenerate" class="btn btn-primary btn-new waves-effect waves-light float-end"><i class="fa-regular fa-file-zipper"></i>  Generate Backup</button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <div id="GridContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section LinkScriptSection {
    <script src="~/js/customjs/empr_DatabaseBackup.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        $(function () {
            empr_DatabaseBackup.InitEvents();
        });
    </script>
    
}