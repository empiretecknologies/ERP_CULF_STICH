@section LinkScriptSection {
    <script type="text/javascript">
        var startDate = @startDate;
        var endDate = @endDate;
        var Items = @Html.Raw(Json.Serialize(ViewBag.Items));
        var Warehouse = @Html.Raw(Json.Serialize(ViewBag.Warehouse));
        var Units = @Html.Raw(Json.Serialize(ViewBag.Units));
        var Branch_RT_TYPE = @Html.Raw(Json.Serialize(ViewBag.Branch_RT_TYPE));
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        var Limit = @Html.Raw(Json.Serialize(ViewBag.Limit));
        var todayDate = '@DateTime.Now.Date.ToString("yyyy-MM-dd")';
        var dataClear = @Html.Raw(Json.Serialize(ViewBag.DATA_CLEAR));
        var pickData = @Html.Raw(Json.Serialize(ViewBag.PICK_DATA));
    </script>
    <script src="~/js/customjs/empr_FDeliveryFeeding.js" asp-append-version="true"></script>
    <script type="text/javascript">
        function validateDateRange(input) {
            let minDate = new Date(input.min);
            let maxDate = new Date(input.max);
            let selectedDate = new Date(input.value);

            if (selectedDate < minDate) {
                input.value = input.min;
            }

            if (selectedDate > maxDate) {
                input.value = input.max;
            }
        }
        $(function () {
            empr_FDeliveryFeeding.Branch_RT_TYPE = Branch_RT_TYPE;
            empr_FDeliveryFeeding.InitEvents();
            empr_helper.EnableShortCutKeys('#BtnSave', '#BtnNew', '#BtnDelete', '#BtnQuickSearch', '#Code', '#deliveryFeedingDetailContainer', 0, 'iteM_CODE', '#SodaPickModal', '#BtnSodaPick', '#SodaPickGridContainer', 0, 'v_DATE', '#BtnAddSodaToDelivery');
        });
    </script>
}