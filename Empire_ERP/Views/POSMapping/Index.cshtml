						<div id="CACCOUNT"></div>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="CASH_TAX">Cash Tax :</label>
						<input class="form-control" id="CASH_TAX" type="text" autocomplete="off">
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="BACCOUNT">Bank Account :</label>
						<div id="BACCOUNT"></div>
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="BANK_TAX">Bank Tax :</label>
						<input class="form-control" id="BANK_TAX" type="text" autocomplete="off">
					</div>
					<div class="col-xl-3">
						<label class="form-label" for="BANK_CHARGES">Bank Charges :</label>
