@section InLineStyleSection {
    <style>
        .sq-page {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 175px);
            min-height: 480px;
            background: #f3f5f7;
            border-radius: 8px;
            overflow: hidden;
        }

        .sq-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 12px;
            background: #fff;
            border-bottom: 1px solid #e5e9ee;
        }

        .sq-toolbar .btn {
            font-size: 12px;
        }

        .sq-toolbar-left {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
            flex: 1;
        }

        .sq-party-display {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            flex: 1;
        }

        .sq-party-display .sq-party-label {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            line-height: 32px;
            color: #1f2a37;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
        }

        .sq-party-name {
            max-width: 280px;
            height: 32px;
            font-size: 12px;
            background-color: #f3f5f7;
            flex: 1;
        }

        .sq-hidden {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }

        .sq-body {
            display: flex;
            flex: 1;
            min-height: 0;
        }

        .sq-groups {
            width: 240px;
            flex-shrink: 0;
            background: #fff;
            border-right: 1px solid #e5e9ee;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .sq-panel-title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #1f2a37;
            padding: 12px 14px 8px;
            margin: 0;
        }

        .sq-group-list {
            overflow-y: auto;
            padding: 4px 10px 12px;
            flex: 1;
        }

        .sq-group {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            border: 1px solid transparent;
            background: transparent;
            border-radius: 8px;
            padding: 8px 24px 8px 10px;
            text-align: left;
            position: relative;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .sq-group:hover {
            background: #f4f8fb;
        }

        .sq-group.active,
        .sq-group.has-data {
            background: #e8f2f8;
            border-color: #c5dce9;
        }

        .sq-group.active:after {
            content: "";
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            border-top: 6px solid transparent;
            border-bottom: 6px solid transparent;
            border-left: 7px solid var(--theme-blue);
        }

        .sq-group-thumb,
        .sq-item-thumb {
            width: 42px;
            height: 42px;
            border-radius: 8px;
            background: #f0f3f6;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            flex-shrink: 0;
            position: relative;
        }

        .sq-item-thumb {
            width: 100%;
            height: 92px;
            border-radius: 8px 8px 0 0;
        }

        .sq-group-thumb img,
        .sq-item-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .sq-thumb-fallback {
            width: 100%;
            height: 100%;
            display: none;
            align-items: center;
            justify-content: center;
            color: var(--theme-blue);
            font-size: 18px;
            background: #eef4f8;
        }

        .sq-item-thumb .sq-thumb-fallback {
            font-size: 28px;
        }

        .sq-group-name {
            font-size: 12px;
            font-weight: 700;
            color: #1f2a37;
            line-height: 1.2;
        }

        .sq-group-count {
            font-size: 11px;
            color: #6b7785;
        }

        .sq-items {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            min-height: 0;
            padding: 10px 14px 0;
        }

        .sq-items-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 2px 0 10px;
        }

        .sq-items-title {
            font-size: 15px;
            font-weight: 700;
            color: #1f2a37;
            margin: 0;
        }

        .sq-item-search {
            max-width: 280px;
            height: 32px;
            font-size: 12px;
            flex-shrink: 0;
        }

        .sq-item-list {
            overflow-y: auto;
            flex: 1;
            min-height: 0;
            padding-bottom: 10px;
        }

        .sq-item-grid {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 12px;
            align-items: stretch;
        }

        .sq-item-card {
            background: #fff;
            border: 1px solid #e5e9ee;
            border-radius: 10px;
            padding: 0 0 10px;
            display: flex;
            flex-direction: column;
            position: relative;
            cursor: pointer;
            user-select: none;
            min-width: 0;
            z-index: 1;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .sq-item-card.sq-item-hidden {
            display: none;
        }

        .sq-item-card:active {
            transform: scale(0.98);
        }

        .sq-item-card.selected {
            border-color: var(--theme-blue);
            background: #f4f9fc;
            box-shadow: 0 0 0 2px rgba(5, 90, 135, 0.18);
        }

        .sq-qty-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 2px;
            min-height: 26px;
            padding: 0 8px;
            border-radius: 13px;
            background: #edf1f4;
            color: #5b6773;
            font-size: 12px;
            font-weight: 700;
        }

        .sq-item-card.selected .sq-qty-badge {
            background: var(--theme-blue);
            color: #fff;
        }

        .sq-qty-minus {
            display: none;
            width: 18px;
            height: 18px;
            border: none;
            background: rgba(255, 255, 255, 0.22);
            color: inherit;
            border-radius: 50%;
            font-size: 14px;
            line-height: 1;
            padding: 0;
            align-items: center;
            justify-content: center;
            margin-right: 2px;
        }

        .sq-item-card.selected .sq-qty-minus {
            display: inline-flex;
        }

        .sq-item-body {
            padding: 8px 10px 0;
            min-width: 0;
        }

        .sq-item-name {
            font-size: 13px;
            font-weight: 700;
            color: #1f2a37;
            line-height: 1.25;
            margin: 0 0 4px;
            min-height: 32px;
        }

        .sq-item-rate {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            margin: 0;
        }

        .sq-item-stock {
            margin: 4px 0 0;
            font-size: 11px;
            font-weight: 600;
            color: #6b7785;
            line-height: 1.2;
        }

        .sq-item-stock-negative,
        .sq-item-stock-negative .sq-item-stock-value {
            color: #dc3545;
        }

        .sq-item-rate label {
            font-size: 11px;
            font-weight: 600;
            margin: 0;
            color: #5b6773;
            text-align: left;
            flex-shrink: 0;
        }

        .sq-rate-input {
            width: 88px;
            height: 26px;
            border: 1px solid #d5dde4;
            border-radius: 4px;
            text-align: right;
            margin-left: auto;
            font-size: 12px;
            font-weight: 600;
            color: var(--theme-blue);
            padding: 0 6px;
        }

        .sq-item-barcode {
            display: flex;
            align-items: center;
            gap: 6px;
            margin: 4px 0 0;
        }

        .sq-item-barcode label {
            font-size: 11px;
            font-weight: 600;
            margin: 0;
            color: #5b6773;
        }

        .sq-barcode-input {
            width: 100%;
            min-width: 0;
            height: 26px;
            border: 1px solid #d5dde4;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            color: var(--theme-blue);
            padding: 0 6px;
        }

        .sq-empty {
            color: #6b7785;
            font-size: 12px;
            padding: 18px 8px;
        }

        .sq-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 12px;
            padding: 10px 14px;
            background: #fff;
            border-top: 1px solid #e5e9ee;
            flex-shrink: 0;
        }

        .sq-summary {
            font-size: 13px;
            font-weight: 600;
            color: #1f2a37;
        }

        .sq-mobile-summary {
            display: none;
        }

        .sq-footer .btn-save,
        .sq-footer .btn-print {
            min-width: 110px;
        }

        #ViewCartModal .modal-dialog {
            max-width: 500px;
        }

        #ViewCartModal .modal-header {
            background: var(--theme-blue);
            color: #fff;
            padding: 10px 14px;
        }

        #ViewCartModal .modal-title {
            font-size: 15px;
        }

        #ViewCartModal .btn-close {
            filter: invert(1);
        }

        #ViewCartModal .modal-body {
            padding: 0;
            overflow: hidden;
        }

        #sqCartBody {
            max-height: 220px;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 6px 12px;
        }

        .sq-cart-empty {
            padding: 16px 8px;
            margin: 0;
            text-align: center;
        }

        .sq-cart-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 7px 0;
            border-bottom: 1px solid #eef2f5;
        }

        .sq-cart-row:last-child {
            border-bottom: 0;
        }

        .sq-cart-row-info {
            min-width: 0;
            flex: 1;
        }

        .sq-cart-item-name {
            font-size: 12px;
            font-weight: 700;
            color: #1f2a37;
            line-height: 1.3;
            word-break: break-word;
        }

        .sq-cart-item-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 4px 10px;
            margin-top: 2px;
            font-size: 11px;
            font-weight: 600;
            color: #5b6773;
        }

        .sq-cart-remove {
            flex-shrink: 0;
            font-size: 11px;
            padding: 2px 8px;
            line-height: 1.4;
        }

        #ViewCartModal .modal-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
            padding: 8px 14px;
        }

        .sq-cart-footer-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 4px 14px;
            font-size: 12px;
            font-weight: 600;
            color: #1f2a37;
        }

        .sq-cart-footer-summary strong {
            color: var(--theme-blue);
        }

        @@media (hover: hover) and (pointer: fine) and (min-width: 992px) {
            .sq-item-list {
                padding: 24px 18px 32px;
            }

            .sq-item-grid {
                gap: 18px;
                overflow: visible;
                isolation: isolate;
            }

            .sq-item-card {
                transform-origin: center center;
                transition: border-color 0.28s ease, box-shadow 0.28s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
            }

            .sq-item-card:hover {
                z-index: 40;
                border-color: #9ec4d6;
                box-shadow: 0 18px 32px rgba(5, 90, 135, 0.22);
                transform: translateY(-10px) scale(1.16);
            }

            .sq-item-card.selected:hover {
                box-shadow: 0 18px 32px rgba(5, 90, 135, 0.22), 0 0 0 2px rgba(5, 90, 135, 0.18);
            }

            .sq-item-card:active {
                transform: translateY(-6px) scale(1.12);
            }
        }

        #SaveQuotationModal .modal-header {
            background: var(--theme-blue);
            color: #fff;
        }

        #SaveQuotationModal .modal-title {
            font-size: 15px;
        }

        #SaveQuotationModal .btn-close {
            filter: invert(1);
        }

        #SaveQuotationModal .modal-dialog,
        #SaveQuotationModal .modal-content,
        #SaveQuotationModal .modal-body {
            overflow: visible;
        }

        #SaveQuotationModal.sq-excel-review-open .modal-body {
            max-height: calc(100vh - 180px);
            overflow-y: auto;
        }

        #BtnUploadFile {
            font-size: 12px;
        }

        .sq-excel-upload {
            display: none;
            margin-top: 8px;
            padding: 10px;
            background: #f3f5f7;
            border: 1px solid #e5e9ee;
            border-radius: 8px;
        }

        .sq-excel-label {
            font-size: 12px;
            font-weight: 700;
            color: #1f2a37;
            margin-bottom: 8px;
        }

        .sq-excel-drop {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 110px;
            padding: 14px 12px;
            background: #fff;
            border: 1px dashed #c5dce9;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
        }

        .sq-excel-drop:hover,
        .sq-excel-drop.sq-excel-dragover {
            border-color: var(--theme-blue);
            background: #f4f9fc;
        }

        .sq-excel-drop i {
            color: var(--theme-blue);
            font-size: 22px;
        }

        .sq-excel-drop-title {
            font-size: 12px;
            font-weight: 700;
            color: #1f2a37;
            margin: 0;
        }

        .sq-excel-drop-hint {
            font-size: 11px;
            color: #6b7785;
            margin: 0;
        }

        .sq-excel-file-name {
            font-size: 11px;
            font-weight: 600;
            color: var(--theme-blue);
            margin: 0;
            word-break: break-all;
        }

        .sq-excel-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: center;
            margin-top: 4px;
        }

        .sq-excel-status {
            margin-top: 8px;
            font-size: 12px;
            font-weight: 600;
            color: #5b6773;
        }

        .sq-excel-status.sq-excel-error {
            color: #dc3545;
        }

        .sq-excel-status.sq-excel-success {
            color: #0CC27E;
        }

        .sq-excel-review {
            margin-top: 10px;
        }

        .sq-excel-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 14px;
            font-size: 12px;
            font-weight: 600;
            color: #1f2a37;
            margin-bottom: 10px;
        }

        .sq-excel-summary strong {
            color: var(--theme-blue);
        }

        .sq-excel-section-title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #1f2a37;
            margin: 0 0 8px;
        }

        .sq-excel-master {
            background: #fff;
            border: 1px solid #e5e9ee;
            border-radius: 8px;
            margin-bottom: 8px;
            overflow: hidden;
        }

        .sq-excel-master-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 8px 10px;
            background: #e8f2f8;
            border-bottom: 1px solid #c5dce9;
            font-size: 12px;
            font-weight: 700;
            color: #1f2a37;
        }

        .sq-excel-table-wrap {
            overflow-x: auto;
            max-height: 180px;
            overflow-y: auto;
        }

        .sq-excel-table {
            width: 100%;
            margin: 0;
            font-size: 11px;
        }

        .sq-excel-table th {
            background: #f3f5f7;
            color: #1f2a37;
            font-weight: 700;
            white-space: nowrap;
            padding: 6px 8px;
            border-color: #e5e9ee;
        }

        .sq-excel-table td {
            padding: 6px 8px;
            border-color: #eef2f5;
            color: #1f2a37;
            vertical-align: top;
        }

        .sq-excel-failed td {
            color: #dc3545;
        }

        .sq-excel-reason {
            font-weight: 600;
            color: #dc3545;
        }

        @@media (max-width: 575px) {
            .sq-excel-drop {
                min-height: 96px;
            }

            .sq-excel-master-head {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        #PARTY_CODE.sq-party-invalid .dx-texteditor,
        #PARTY_CODE.sq-party-invalid .dx-texteditor.dx-editor-outlined,
        #PARTY_CODE.sq-party-invalid .dx-dropdowneditor {
            border-color: #dc3545 !important;
        }

        #PARTY_CODE.sq-party-invalid .dx-texteditor.dx-state-hover,
        #PARTY_CODE.sq-party-invalid .dx-texteditor.dx-state-focused,
        #PARTY_CODE.sq-party-invalid .dx-texteditor.dx-state-active {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 1px #dc3545 !important;
        }

        @@media (max-width: 991px) {
            .sq-page {
                height: auto;
                min-height: 0;
                overflow: visible;
            }

            .sq-body {
                flex-direction: column;
            }

            .sq-groups {
                width: 100%;
                border-right: 0;
                border-bottom: 1px solid #e5e9ee;
            }

            .sq-group-list {
                display: flex;
                overflow-x: auto;
                overflow-y: hidden;
                gap: 6px;
                padding: 0 10px 10px;
            }

            .sq-group {
                min-width: 160px;
                margin-bottom: 0;
            }

            .sq-item-grid {
                grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
            }

            .sq-item-list {
                height: 600px;
                min-height: 0;
                flex: none;
                overflow-y: auto;
            }

            .sq-mobile-summary {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                padding: 8px 12px;
                background: #fff;
                border-bottom: 1px solid #e5e9ee;
                flex-shrink: 0;
            }

            .sq-mobile-summary-totals {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 4px 14px;
                min-width: 0;
                font-size: 12px;
                font-weight: 600;
                color: #1f2a37;
                line-height: 1.25;
            }

            .sq-mobile-summary-totals span {
                white-space: nowrap;
            }

            .sq-mobile-summary-totals strong {
                color: var(--theme-blue);
            }

            #BtnViewCart {
                flex-shrink: 0;
                font-size: 12px;
                white-space: nowrap;
            }

            .sq-footer .sq-summary {
                display: none;
            }

            .sq-item-card:hover,
            .sq-item-card.selected:hover {
                transform: none;
                box-shadow: none;
            }

            .sq-item-card.selected:hover {
                box-shadow: 0 0 0 2px rgba(5, 90, 135, 0.18);
            }

            #sqCartBody {
                max-height: 190px;
            }
        }

        @@media (max-width: 575px) {
            .sq-toolbar {
                flex-wrap: wrap;
            }

            .sq-items-head {
                flex-direction: column;
                align-items: stretch;
            }

            .sq-item-search {
                max-width: none;
                width: 100%;
            }

            .sq-item-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .sq-item-list {
                height: calc((92px + 8px + 32px + 4px + 26px + 4px + 26px + 4px + 14px + 10px) * 3 + 12px * 2 + 10px);
            }

            .sq-toolbar-left {
                width: 100%;
            }

            .sq-party-display {
                width: 100%;
            }

            .sq-party-name {
                max-width: none;
                flex: 1;
            }

            .sq-footer {
                justify-content: space-between;
            }

            .sq-footer .btn {
                width: 100%;
            }

            #ViewCartModal .modal-dialog {
                margin: 0.5rem;
                max-width: calc(100% - 1rem);
            }
        }
    </style>
}

<div class="sq-page Record">
    <div class="sq-toolbar">
        <div class="sq-toolbar-left">
            <button type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal"
                    data-bs-target=".bs-example-modal-xl" id="BtnQuickSearch">
                <i class="fa fa-search"></i> Quick Search
            </button>
            <div class="sq-party-display">
                <label class="form-label sq-party-label" for="PARTY_NAME_DISPLAY">Party</label>
                <input class="form-control sq-party-name" id="PARTY_NAME_DISPLAY" type="text" readonly placeholder="Party Name" autocomplete="off">
                <button type="button" class="btn btn-light" id="BtnChangeParty">Change Party</button>
            </div>
        </div>
        <div>
            <button class="btn btn-danger btn-delete" id="BtnDelete" style="display:none"><i class="fa fa-trash"></i> Delete</button>
            <button type="button" class="btn btn-primary btn-new waves-effect waves-light" id="BtnNew">
                <i class="fa fa-plus"></i> Add New
            </button>
        </div>
    </div>

    <div class="sq-mobile-summary">
        <div class="sq-mobile-summary-totals">
            <span>Total Items: <strong id="sqMobileTotalItems">0</strong></span>
            <span>Total Amount: <strong id="sqMobileTotalAmount">0.00</strong></span>
        </div>
        <button type="button" class="btn btn-primary btn-sm" id="BtnViewCart">
            <i class="fa fa-shopping-cart"></i> View Cart
        </button>
    </div>

    <div class="sq-hidden">
        <input id="ID" hidden />
        <input id="partyhidden" hidden />
        <input id="acthidden" hidden />
        <input id="Code" readonly type="text" autocomplete="off">
        <div id="ASTATUS"></div>
    </div>

    <div class="sq-body">
        <aside class="sq-groups">
            <h2 class="sq-panel-title">Item Groups</h2>
            <div class="sq-group-list" id="sqGroupList"></div>
        </aside>
        <section class="sq-items">
            <div class="sq-items-head">
                <h2 class="sq-items-title" id="sqItemListTitle">Item List</h2>
                <input type="text" id="sqItemSearch" class="form-control sq-item-search" placeholder="Search by Item Name / Item Code" autocomplete="off">
            </div>
            <div class="sq-item-list" id="sqItemList"></div>
        </section>
    </div>

    <div class="sq-footer">
        <div class="sq-summary" id="sqSummary">Total Items: 0 | Total Amount: 0.00</div>
        <button type="button" class="btn btn-success btn-print" id="BtnPrint" style="display:none"><i class="fa fa-print"></i> Print</button>
        <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
