                    </div>
                    <div class="col-xl-3 vHide">
                        <label class="form-label" for="VOUCHER_NO">Transaction #:</label>
                        <input class="form-control" id="VOUCHER_NO" type="text" readonly autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="REF">Reference No:</label>
                        <input class="form-control" id="REF" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="SellerCode">Party Name:</label>
                        <div id="SellerCode"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="SellerCode">COA:</label>
                        <div id="ACCOUNT_NAME"></div>
                    </div>
                    @* <div class="col-xl-3">
                        <label class="form-label" for="BuyerCode">Buyer Code:</label>
                        <div id="BuyerCode"></div>
                    </div> *@
                    <div class="col-xl-3">
                        <label class="form-label" for="BrokerCode">Broker Name:</label>
                        <div id="BrokerCode"></div>
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="D_NAME">Driver Name:</label>
                        <input class="form-control" id="D_NAME" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="D_NUM">Driver No:</label>
                        <input class="form-control" id="D_NUM" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="Condition">Condition:</label>
                        <div id="Condition"></div>
                    </div>
                    <div class="col-xl-1 ConditionDiv" style="display:none">
                        <label class="form-label" for="CreditDays">Cr. Days:</label>
                        <input class="form-control" id="CreditDays" type="number" min="0" max="3" autocomplete="off" oninput="if(this.value.length > 3) this.value = this.value.slice(0, 3); empr_FDeliveryFeeding.AutoCalculateDueDate(this)">
                    </div>
                    <div class="col-xl-2 ConditionDiv" style="display:none">
                        <label class="form-label" for="DueDate">Due Date:</label>
                        <input class="form-control" id="DueDate" type="date" autocomplete="off" onkeydown="empr_helper.HandleTabFocus(event, '#REMARKS')" oninput="empr_FDeliveryFeeding.AutoCalculateDays(this)">
                    </div>
                    <div class="col-xl-3">
                        <label class="form-label" for="Type">Type:</label>
                        <div id="SBF_TYPE" onkeydown="empr_SodaBookFeeding.MoveFocusToGridShiftTab(event, '#DetailContainer', 0, 'iteM_CODE')"></div>
                    </div>
                    <div class="col-xl-9">
                        <label class="form-label" for="REMARKS">Comment:</label>
