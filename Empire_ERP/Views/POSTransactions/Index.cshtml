<div class="modal fade" id="PrinterSetting" tabindex="-1" aria-labelledby="myModalLabel" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content animatemodal" style="width: 65%;margin-left: 27%;margin-top: 30%;">

            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="myModalLabel">Printer settings</h5>
                <button type="button" class="btn-close close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">

                <!-- Field 1 -->
                <div class="mb-3" id="divPaySetting" style="">
                    <label class="form-label" style="font-size: 15px;">Pay Bill Print Copies</label>
                    <input type="number" style="font-size: 15px;" class="form-control" id="paySetting" placeholder="Enter Numeric value">
                </div>

                <!-- Field 2 -->
                <div class="mb-3" id="divPreSetting" style="display: none;">
                    <label class="form-label" style="font-size: 15px;">Pre Bill Print Copies</label>
                    <input type="number" class="form-control" style="font-size: 15px;" id="preSetting" placeholder="Enter Numeric value">
                </div>

                <!-- Field 3 -->
                <div class="mb-3" id="divDupSetting" style="display: none;">
                    <label class="form-label" style="font-size: 15px;">Duplicate Bill Print Copies</label>
                    <input type="number" class="form-control" style="font-size: 15px;" id="dupSetting" placeholder="Enter Numeric value">
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" class="btn settingEnter">OK</button>
            </div>

        </div>
    </div>
</div>

