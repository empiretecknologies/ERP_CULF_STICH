                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="LNUMBER">License No. :</label>
                            <input class="form-control" id="LNUMBER" type="text" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="L_IDATE">License Issue Date :</label>
                            <input class="form-control" id="L_IDATE" type="date" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="L_EDATE">License Expiry Date :</label>
                            <input class="form-control" id="L_EDATE" type="date" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="LEFT_DATE">Leaving Date :</label>
                            <input class="form-control" id="LEFT_DATE" type="date" autocomplete="off">
                        </div>
                        <div class="col-xl-3">
                            <label class="form-label" for="REASON_L">Reason of Leaving :</label>
                            <textarea class="form-control" id="REASON_L" rows="1" type="text" autocomplete="off"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade show active" id="pills-warningholiday" role="tabpanel" aria-labelledby="pills-warningholiday-tab">
            <div class="HR_Holiday">
                <div class="table-responsive">
                    <div id="DetailContainer"></div>
                </div>
                <div class="col-xl-12 text-end">
                    <button class="btn btn-primary btn-save saveAttempt" style="    margin: 7px 0px 0px 0;width: 148px;">
                        <i class="fa fa-save"></i> Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
