@{
	var startDate = (Convert.ToDateTime(ViewBag.StartDate)).ToString("yyyy-MM-dd");
	var endDate = (Convert.ToDateTime(ViewBag.EndDate)).ToString("yyyy-MM-dd");
}

<style>
	.rating-container {
		display: flex;
		align-items: center; /* vertically center */
		gap: 15px; /* elements ke beech gap */
	}

	.rating {
		display: flex;
		gap: 5px;
		cursor: pointer;
		font-size: 1.5rem;
	}

	.star {
		position: relative;
		color: lightgray;
		transition: color 0.3s ease, transform 0.2s ease;
	}

		.star.full {
			color: steelblue;
			transform: scale(1.1);
		}

		.star.half::before {
			content: "★";
			position: absolute;
			left: 0;
			width: 50%;
			overflow: hidden;
			color: steelblue;
			transition: color 0.3s ease;
		}

	#selectedRating {
		font-size: 1rem;
	}
</style>


<div class="card">
	<div class="row">
		<div class="col-md-12">
			<div class="card-header">
				<button id="quicksearch" type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl"><i class="fa fa-search"></i> Quick Search</button>
				<button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="resetall" style="display:none"><i class="fa fa-plus"></i> Add New</button>
			</div>
			<div class="card-body pt-1 Record">
				<div class="row theme-form">
					<input type="hidden" id="EMP_EMAIL" />
					<input type="hidden" id="ACT_GROUP_hidden" />
					<input type="hidden" id="displayExprAccGroup" />

					<input type="hidden" id="communicationRating">
					<input type="hidden" id="technicalRating">
					<input type="hidden" id="problemRating">
					<input type="hidden" id="confidenceRating">
					<input type="hidden" id="culturalRating">


					<div class="col-xl-3">
						<div class="row">
							<div class="col-md-6">
								<label class="form-label" for="Code">Code :</label>
								<input class="form-control" readonly id="Code" type="text" autocomplete="off">
							</div>

							<div class="col-md-6">
								<label class="form-label" for="ASTATUS">Status :</label>
								<div id="ASTATUS"></div>
							</div>
						</div>
					</div>



					<div class="col-xl-9">
						<label class="form-label" for="color">Employee:</label>
						<div id="ENAME"></div>
						<div id="ColorSingle"></div>
					</div>

					<div class="col-xl-3">
						<label class="form-label" for="INTERVIEW">Interview:</label>
						<div id="INTERVIEW"></div>
					</div>

					<div class="col-xl-3">
